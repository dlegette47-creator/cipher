              <div className="flex items-center gap-2">
                <input type="checkbox" checked={isChannel} onChange={(e) => setIsChannel(e.target.checked)} id="isChannel" className="rounded border-white/10 bg-black" />
                <label htmlFor="isChannel" className="text-sm text-white/80">Create as Channel</label>
              </div>
              <button type="submit" onClick={createGroup} disabled={loading || newGroupName.trim().length === 0} className="w-full bg-blue-600 hover:bg-blue-500 disabled:opacity-50 text-white font-semibold py-3 rounded-lg transition-colors">
                {loading ? 'Creating...' : 'Create'}
              </button>
            </form>
          </div>
        </div>
      )}

        {showMenu && (
          <div className="absolute inset-0 z-40 bg-black/50 backdrop-blur-sm" onClick={() => setShowMenu(false)}>
            <div className="absolute bottom-24 right-6 flex flex-col gap-3 items-end">
              <button onClick={() => { setShowMenu(false); setView('search') }} className="flex items-center gap-3 bg-surface px-4 py-3 rounded-full border border-white/10 shadow-xl animate-slide-up">
                <span className="text-sm font-semibold">New Chat</span>
                <div className="p-2 bg-blue-500 rounded-full text-white"><MessageIcon size={18}/></div>
              </button>
              <button onClick={() => { setShowMenu(false); setShowCreateGroup(true) }} className="flex items-center gap-3 bg-surface px-4 py-3 rounded-full border border-white/10 shadow-xl animate-slide-up" style={{ animationDelay: '50ms' }}>
                <span className="text-sm font-semibold">New Group/Channel</span>
                <div className="p-2 bg-green-500 rounded-full text-white"><Users size={18}/></div>
              </button>
            </div>
          </div>
        )}

        <button onClick={() => setShowMenu(true)} className="fixed bottom-24 right-6 p-4 bg-white text-black rounded-full shadow-lg hover:scale-105 active:scale-90 transition-transform z-50">
          <Plus size={24} />
        </button>
      </motion.div>
    )
  }

  // --- SEARCH VIEW ---
  if (view === 'search') {
    return (
      <div className="flex flex-col h-[calc(100vh-80px)] bg-base">
        <ToastUI />
        <div className="p-4 border-b border-white/5 flex flex-col gap-3">
          <div className="flex items-center gap-3">
            <button onClick={() => setView('list')} className="p-2 -ml-2 text-white/60"><ArrowLeft size={20} /></button>
            <div className="flex-1 flex items-center bg-surfaceLight rounded-full px-4 py-2 border border-white/10">
              <Search size={16} className="text-white/40 mr-2"/>
              <textarea 
                autoFocus 
                rows={1}
                value={searchQuery} 
                onChange={(e) => setSearchQuery(e.target.value)} 
                onKeyDown={(e) => { if(e.key === 'Enter') { e.preventDefault(); handleSearch(); } }} 
                placeholder="Search @users, groups, or paste npub/hex..." 
                className="bg-transparent text-sm text-white outline-none w-full resize-none pt-1" 
              />
            </div>
            <button onClick={handleSearch} className="text-sm font-bold text-blue-400">Search</button>
          </div>
          
          <div className="flex items-center gap-2">
            <input 
              type="text" 
              id="join-group-id"
              placeholder="Paste Group ID to join directly..." 
              className="flex-1 bg-surfaceLight border border-white/10 rounded-lg px-4 py-2 text-sm text-white outline-none focus:border-blue-500"
            />
            <button 
              onClick={() => { const gid = document.getElementById('join-group-id').value.trim(); if (gid) joinGroupById(gid); }}
              className="bg-green-600 hover:bg-green-500 text-white text-sm font-bold px-4 py-2 rounded-lg"
            >
              Join
            </button>
          </div>
        </div>
        
        <div className="flex-1 overflow-y-auto p-4 space-y-3">
          {isSearching && <p className="text-center text-white/50 animate-pulse">Searching relays...</p>}
          {searchResults.map((res, i) => (
            <div key={i} onClick={() => {
              if (res.type === 'user') { openChat('dm', res.pubkey); }
              else if (res.type === 'group') { 
                // Save to our local list so it doesn't disappear!
                const localGroups = JSON.parse(localStorage.getItem('cipher_my_groups') || '[]');
                if (!localGroups.find(g => g.id === res.id)) {
                  localGroups.push({ id: res.id, name: res.name, isChannel: res.isChannel, creator: res.creator });
                  localStorage.setItem('cipher_my_groups', JSON.stringify(localGroups));
                }
                openChat('group', res.id, res); 
              }
              else { openChat('group', res.id, { id: res.id, name: res.name, isChannel: res.isChannel, creator: res.creator }); }
            }} className="bg-surface p-4 rounded-2xl border border-white/5 flex items-center gap-4 cursor-pointer">
              {res.type === 'user' ? (
                res.picture ? <img src={res.picture} className="w-10 h-10 rounded-full" /> : <div className="w-10 h-10 rounded-full bg-surfaceLight flex items-center justify-center font-bold">{res.name?.charAt(0)}</div>
              ) : (
                <div className="w-10 h-10 rounded-full bg-purple-500/20 flex items-center justify-center">{res.isChannel ? <Megaphone size={18} className="text-purple-400"/> : <Users size={18} className="text-blue-400"/>}</div>
              )}
              <div>
                <p className="text-sm font-bold">{res.name}</p>
                <p className="text-[10px] text-white/40 uppercase">{res.type}</p>
              </div>
            </div>
          ))}
          {!isSearching && searchResults.length === 0 && (
            <div className="text-center mt-10 px-4">
              <p className="text-white/60 mb-2">No results found.</p>
              <p className="text-xs text-white/40 mb-4">
                Nostr search can be slow for new accounts. 
                <br/>
                For a 100% guaranteed connection, ask your friend to send you their <strong>npub</strong> or <strong>NIP-05 address</strong> (like name@domain.com) and paste it here.
              </p>
            </div>
          )}
        </div>
      </div>
    )
  }

  // --- ACTIVE DM VIEW ---
  if (view === 'dm' && activeDm) {
    const activeMessages = dms[activeDm] || []
    // ✅ FIX: Use hoisted profiles
    const profile = profiles[activeDm] || { displayName: activeDm.slice(0,8) }

    return (
      <motion.div initial={{ x: 20, opacity: 0 }} animate={{ x: 0, opacity: 1 }} exit={{ x: 20, opacity: 0 }} transition={{ duration: 0.2 }} className="fixed inset-0 z-50 flex flex-col bg-[#0a0a0a] pb-[72px]">
        <ToastUI />
        <ContextMenu />
        
        <div className="flex items-center gap-3 p-4 bg-surface/90 backdrop-blur-md border-b border-white/5 flex-shrink-0">
          <button onClick={() => setView('list')} className="p-2 -ml-2 text-white/60 hover:text-white active:scale-90 transition-transform"><ArrowLeft size={20} /></button>
          {profile.picture ? <img src={profile.picture} className="w-8 h-8 rounded-full" /> : <div className="w-8 h-8 rounded-full bg-surfaceLight flex items-center justify-center text-xs font-bold">{profile.displayName.charAt(0)}</div>}
          <div>
            <h3 className="text-sm font-semibold">{profile.displayName}</h3>
          </div>
        </div>
        
        <div ref={scrollRef} className="flex-1 overflow-y-auto overflow-x-hidden min-h-0 p-4 space-y-4">
          {activeMessages.map((msg, i) => {
            if (deletedMsgs.has(msg.id)) return null
            const showTail = i === 0 || activeMessages[i-1].isSender !== msg.isSender
            const repliedMsg = msg.replyTo ? activeMessages.find(m => m.id === msg.replyTo) : null
            
            return (
              <div key={msg.id} className={`flex flex-col ${msg.isSender ? 'items-end' : 'items-start'} animate-fade-in`}>
                <div 
                  onClick={() => setSelectedMessage({ id: msg.id, pubkey: msg.pubkey, text: msg.data.message || msg.data.url })}
                  className={`max-w-[85%] px-4 py-2 relative shadow-sm cursor-pointer group ${
                  msg.isSender 
                    ? `bg-[#2b5278] text-white ${showTail ? 'rounded-2xl rounded-tr-sm' : 'rounded-2xl'}` 
                    : `bg-[#182533] text-white ${showTail ? 'rounded-2xl rounded-tl-sm' : 'rounded-2xl'}`
                }`}>
                  
                  {repliedMsg && (
                    <div className="bg-black/20 p-2 rounded-lg mb-2 border-l-2 border-blue-400 text-xs text-white/70 truncate">
                      {repliedMsg.data.message || repliedMsg.data.url}
                    </div>
                  )}

                  {msg.data.type === 'cipher_order' && <div className="font-bold text-sm mb-1">📦 Order Received</div>}
                  {msg.data.type === 'image' && <img src={msg.data.url} className="rounded-lg max-h-60 object-cover mb-1" />}
                  {msg.data.type === 'audio' && <audio controls src={msg.data.url} className="max-w-full h-10 mb-1" />}
                  {msg.data.type === 'audio' && <audio controls src={msg.data.url} className="max-w-full h-10 mb-1" />}
                  {msg.data.type === 'text' && <p className="text-[15px] leading-snug break-words overflow-hidden w-full">{renderMessage(msg.data.message)}</p>}
                  
                  <div className="flex items-center justify-end gap-1 mt-1 opacity-60">
                    <span className="text-[10px]">{new Date(msg.timestamp * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                  </div>
                </div>
              </div>
            )
          })}
          <div className="h-4" />
        </div>

        <div className="p-3 bg-[#111] border-t border-white/10 flex-shrink-0 flex flex-col gap-2">
          {replyingTo && (
            <div className="flex items-center justify-between bg-surfaceLight px-3 py-2 rounded-xl border-l-2 border-blue-500">
              <div className="flex flex-col truncate pr-4 text-xs text-white/70">
                <span className="font-bold text-blue-400">Replying to {replyingTo.pubkey === identity.pk ? 'Yourself' : profile.displayName}</span>
                <span className="truncate">{replyingTo.text || 'Media'}</span>
              </div>
              <button onClick={() => setReplyingTo(null)} className="p-1 bg-black/20 rounded-full text-white/50 hover:text-white"><X size={14}/></button>
            </div>
          )}

          {showEmojiPicker && (
            <div className="bg-surfaceLight p-3 rounded-2xl grid grid-cols-8 gap-2 mb-2 animate-slide-up">
              {Emojis.map(e => (
                <button key={e} onClick={() => setReplyText(prev => prev + e)} className="text-xl hover:scale-125 transition-transform">{e}</button>
              ))}
            </div>
          )}

          <form onSubmit={(e) => { e.preventDefault(); sendMessage(replyText); }} className="flex items-end gap-2 max-w-md mx-auto w-full">
            <input type="file" accept="image/*" onChange={handleImageUpload} className="hidden" ref={fileInputRef} />
            <button type="button" onClick={() => fileInputRef.current?.click()} disabled={uploadingImage} className="p-3 rounded-full bg-surfaceLight text-white/50 hover:text-white transition-colors">
              {uploadingImage ? <RefreshCw size={20} className="animate-spin" /> : <ImageIcon size={20} />}
            </button>
            
            <div className="flex-1 bg-surfaceLight rounded-3xl border border-white/10 overflow-hidden flex items-center px-2 py-1">
              <button type="button" onClick={() => setShowEmojiPicker(!showEmojiPicker)} className="p-2 text-white/40 hover:text-white"><Smile size={20}/></button>
              <input 
                type="text" 
                value={replyText} 
                onChange={(e) => setReplyText(e.target.value)} 
                placeholder="Message" 
                className="flex-1 bg-transparent px-2 py-2 text-[15px] text-white outline-none placeholder-white/30" 
              />
            </div>
            
            {replyText.trim() ? (
              <button type="submit" className="p-3 rounded-full flex-shrink-0 transition-transform active:scale-90 shadow-lg bg-[#2b5278] text-white">
                <Send size={20} className="-ml-0.5 mt-0.5" />
              </button>
            ) : (
              <button type="button" onClick={isRecording ? stopRecording : startRecording} className={`p-3 rounded-full flex-shrink-0 transition-transform active:scale-90 shadow-lg ${isRecording ? 'bg-red-500 text-white animate-pulse' : 'bg-surfaceLight text-white/50'}`}>
                {isRecording ? <Square size={20} /> : <Mic size={20} />}
              </button>
            )}
          </form>
        </div>
      </motion.div>
    )
  }

  // --- ACTIVE GROUP VIEW ---
  if (view === 'group' && activeGroup) {
    const messages = groupMessages[activeGroup.id] || []
    const canPost = !activeGroup.isChannel || activeGroup.creator === identity.pk

    return (
      <motion.div initial={{ x: 20, opacity: 0 }} animate={{ x: 0, opacity: 1 }} exit={{ x: 20, opacity: 0 }} transition={{ duration: 0.2 }} className="fixed inset-0 z-50 flex flex-col bg-[#0a0a0a] pb-[72px]">
        <ToastUI />
        <ContextMenu />

        <div className="flex items-center justify-between p-4 bg-surface/90 backdrop-blur-md border-b border-white/5 flex-shrink-0">
          <div className="flex items-center gap-3">
            <button onClick={() => setView('list')} className="p-2 -ml-2 text-white/60 hover:text-white active:scale-90 transition-transform"><ArrowLeft size={20} /></button>
            <div className={`w-10 h-10 rounded-full flex items-center justify-center bg-blue-500/20`}>
              {activeGroup.isChannel ? <Megaphone size={20} className="text-purple-400"/> : <Users size={20} className="text-blue-400"/>}
            </div>
            <div>
              <h3 className="text-[15px] font-semibold flex items-center gap-1.5">{activeGroup.name}</h3>
              <p className="text-[11px] text-white/40 flex items-center gap-2">
                {activeGroup.isChannel ? 'Channel' : 'Group'} 
                <span className="text-[10px] bg-white/10 px-1.5 py-0.5 rounded text-white/50 cursor-pointer hover:text-white" onClick={() => { navigator.clipboard.writeText(activeGroup.id); setToast({type:'success', message:'Group ID Copied'}); }}>
                  ID: {activeGroup.id.slice(0, 8)}...
                </span>
              </p>
              <button onClick={() => leaveGroup(activeGroup.id)} className="ml-auto text-xs text-red-400 hover:text-red-300 font-bold px-3 py-1 bg-red-500/10 rounded-full">
                Leave
              </button>
            </div>
          </div>
          <button onClick={() => {
            const { nip19 } = require('nostr-tools');
            const relayUrl = 'wss://groups.aegispayhq.com';
            const relayPubkey = activeGroup.creator || identity.pk; // Fallback
            const naddr = nip19.naddrEncode({
              kind: 39000,
              pubkey: relayPubkey,
              identifier: activeGroup.id,
              relays: [relayUrl]
            });
            const url = `${window.location.origin}?naddr=${naddr}`;
            navigator.clipboard.writeText(`Join my group "${activeGroup.name}" on Cipher!\nLink: ${url}`);
            setToast({type: 'success', message: 'Invite Link Copied!'})
          }} className="p-2.5 bg-surfaceLight rounded-full text-white/70 hover:text-white transition-colors">
            <Share2 size={18} />
          </button>
        </div>

        <div ref={scrollRef} className="flex-1 overflow-y-auto overflow-x-hidden min-h-0 p-4 space-y-4">
          {messages.map((msg, i) => {
            if (deletedMsgs.has(msg.id)) return null
            const showTail = i === 0 || messages[i-1].isSender !== msg.isSender
            let parsed = {}; try { parsed = JSON.parse(msg.rawContent) } catch(e) {}
            const repliedMsg = msg.replyTo ? messages.find(m => m.id === msg.replyTo) : null
            let repliedParsed = {}; try { repliedParsed = JSON.parse(repliedMsg?.rawContent) } catch(e) {}
            
            return (
              <div key={msg.id} className={`flex flex-col ${msg.isSender ? 'items-end' : 'items-start'} animate-fade-in`}>
                <div 
                  onClick={() => setSelectedMessage({ id: msg.id, pubkey: msg.pubkey, text: parsed.message || parsed.url })}
                  className={`max-w-[85%] px-4 py-2 relative shadow-sm cursor-pointer group ${
                  msg.isSender 
                    ? `bg-[#2b5278] text-white ${showTail ? 'rounded-2xl rounded-tr-sm' : 'rounded-2xl'}` 
                    : `bg-[#182533] text-white ${showTail ? 'rounded-2xl rounded-tl-sm' : 'rounded-2xl'}`
                }`}>
                  
                  {repliedMsg && (
                    <div className="bg-black/20 p-2 rounded-lg mb-2 border-l-2 border-blue-400 text-xs text-white/70 truncate">
                      {repliedParsed.message || repliedParsed.url}
                    </div>
                  )}

                  {!msg.isSender && <p className="text-[11px] text-blue-300 font-semibold mb-1">{msg.pubkey.slice(0,8)}</p>}
                  {parsed.type === 'image' && <img src={parsed.url} className="rounded-lg max-h-60 object-cover mb-1" />}
                  {parsed.type === 'audio' && <audio controls src={parsed.url} className="max-w-full h-10 mb-1" />}
                  {parsed.type === 'text' && <p className="text-[15px] leading-snug break-words">{renderMessage(parsed.message)}</p>}
                  
                  <div className="flex items-center justify-end gap-1 mt-1 opacity-60">
                    <span className="text-[10px]">{new Date(msg.timestamp * 1000).toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' })}</span>
                  </div>
                </div>
              </div>
            )
          })}
          <div className="h-4" />
        </div>

        <div className="p-3 bg-[#111] border-t border-white/10 flex-shrink-0 flex flex-col gap-2">
          {canPost ? (
            <>
              {replyingTo && (
                <div className="flex items-center justify-between bg-surfaceLight px-3 py-2 rounded-xl border-l-2 border-blue-500">
                  <div className="flex flex-col truncate pr-4 text-xs text-white/70">
                    <span className="font-bold text-blue-400">Replying to {replyingTo.pubkey === identity.pk ? 'Yourself' : replyingTo.pubkey.slice(0,8)}</span>
                    <span className="truncate">{replyingTo.text || 'Media'}</span>
                  </div>
                  <button onClick={() => setReplyingTo(null)} className="p-1 bg-black/20 rounded-full text-white/50 hover:text-white"><X size={14}/></button>
                </div>
              )}

              <form onSubmit={(e) => { e.preventDefault(); sendMessage(replyText); }} className="flex items-end gap-2 max-w-md mx-auto w-full">
                <div className="flex-1 bg-surfaceLight rounded-3xl border border-white/10 overflow-hidden flex items-center px-2 py-1">
                  <input 
                    type="text" 
                    value={replyText} 
                    onChange={(e) => setReplyText(e.target.value)} 
                    placeholder={activeGroup.isChannel ? "Broadcast..." : "Message group"} 
                    className="flex-1 bg-transparent px-2 py-2 text-[15px] text-white outline-none placeholder-white/30" 
                  />
                </div>
                
                {replyText.trim() ? (
                  <button type="submit" className="p-3 rounded-full flex-shrink-0 transition-transform active:scale-90 shadow-lg bg-[#2b5278] text-white">
                    <Send size={20} className="-ml-0.5 mt-0.5" />
                  </button>
                ) : (
                  <button type="button" className={`p-3 rounded-full flex-shrink-0 transition-transform active:scale-90 shadow-lg bg-surfaceLight text-white/50`}>
                    <Mic size={20} />
                  </button>
                )}
              </form>
            </>
          ) : (
            <div className="text-center text-white/40 text-xs py-2">
              Only the channel creator can post here.
            </div>
          )}
        </div>
      
      </motion.div>
    )
  }

  return null
}

function MessageIcon({ size }) {
  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
}
