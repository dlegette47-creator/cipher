function renderMessage(text) {
  if (!text) return null;
  const parts = text.split(/(\|\|.*?\|\|)/g);
  return parts.map((part, i) => {
    if (part.startsWith('||') && part.endsWith('||')) {
      return <span key={i} onClick={(e) => { e.currentTarget.classList.remove('blur-sm', 'text-transparent'); e.currentTarget.classList.add('text-white'); }} className="bg-surfaceLight px-1 rounded cursor-pointer blur-sm text-transparent transition-all select-none">{part.slice(2, -2)}</span>
    }
    const boldParts = part.split(/(\*\*.*?\*\*)/g);
    return boldParts.map((bp, j) => {
      if (bp.startsWith('**') && bp.endsWith('**')) return <strong key={`${i}-${j}`}>{bp.slice(2, -2)}</strong>
      return bp
    })
  })
}

// ✅ GLOBAL POOL: Lives outside React so StrictMode doesn't kill it
// Revised Global Pool Logic

const copyToClipboard = async (text) => {
  console.log("[Clipboard] Attempting to copy:", text);
  try {
    if (navigator.clipboard && window.isSecureContext) {
      await navigator.clipboard.writeText(text);
      console.log("[Clipboard] Success via modern API");
      return true;
    }
  } catch (err) {
    console.warn("[Clipboard] Modern API failed, trying fallback", err);
  }

  // Fallback for mobile/HTTP
  try {
    const textArea = document.createElement("textarea");
    textArea.value = text;
    textArea.style.position = "fixed";
    textArea.style.top = "0";
    textArea.style.left = "0";
    textArea.style.opacity = "0";
    document.body.appendChild(textArea);
    textArea.focus();
    textArea.select();
    const successful = document.execCommand('copy');
    document.body.removeChild(textArea);
    console.log("[Clipboard] Fallback success:", successful);
    return successful;
  } catch (err) {
    console.error("[Clipboard] Fallback failed", err);
    return false;
  }
};

export default function Chat({ identity }) {
  const {view, setView, activeDm, setActiveDm, activeGroup, setActiveGroup,
    dms, setDms, groups, groupMessages, setGroupMessages,
    reactions, setReactions, deletedMsgs, setDeletedMsgs,
    replyingTo, setReplyingTo, loading, setLoading,
    uploadingImage, setUploadingImage, isRecording, setIsRecording,
    showMenu, setShowMenu, showCreateGroup, setShowCreateGroup,
    checkoutProduct, setCheckoutProduct, myProducts, setMyProducts,
    showAddProduct, setShowAddProduct, newProduct, setNewProduct,
    showGroupInfo, setShowGroupInfo, setGroupMembers,
    profiles, setProfiles, unreadCounts, setUnreadCounts,
    searchQuery, setSearchQuery, searchResults, setSearchResults,
    isSearching, setIsSearching, selectedMessage, setSelectedMessage,
    newMessage, setNewMessage, newGroupName, setNewGroupName,
    newGroupAbout, setNewGroupAbout, isChannel, setIsChannel,
    toast, setToast, typingUsers, setTypingUsers, groupTypingUsers, setGroupTypingUsers,
    profilePubkey, setProfilePubkey, showMyProfile, setShowMyProfile,
    myName, setMyName, myUsername, setMyUsername, myAbout, setMyAbout,
    isVendor
  } = useChatStore();
    
  // 🛡️ BULLETPROOF GROUP FILTER
  // Intercepts ALL setGroups calls. If "lmfao" or any relay group isn't in 
  // the local joined list, it is erased before Zustand updates.
  const setGroupsStore = useChatStore((s) => s.setGroups);
  const selectedMsgs = useChatStore(s => s.selectedMsgs);
  const setGroups = useCallback((val) => {
    setGroupsStore((prev) => {
      const next = typeof val === 'function' ? val(prev) : val;
      const myGroupsRaw = localStorage.getItem('cipher_my_groups_' + identity?.pk?.slice(0,16));
      const myGroupIds = new Set(myGroupsRaw ? JSON.parse(myGroupsRaw).map(g => g.id) : []);
      return (next || []).filter(g => myGroupIds.has(g.id));
    });
  }, [identity?.pk, setGroupsStore]);
  const [reviewTarget, setReviewTarget] = useState(null);
  const [vendorStorefrontPubkey, setVendorStorefrontPubkey] = useState(null);
  const [editingProduct, setEditingProduct] = useState(null);
  const [broadcastProduct, setBroadcastProduct] = useState(null);
  const [showQRScanner, setShowQRScanner] = useState(false);
  const [showNotifCenter, setShowNotifCenter] = useState(false);
  const [showBookmarks, setShowBookmarks] = useState(false);
  const postListingGroup = useChatStore(s => s.postListingGroup);
  const setPostListingGroup = useChatStore(s => s.setPostListingGroup);
  const [showFullEmoji, setShowFullEmoji] = useState(false);
  const { sendDM, subscribeToDMs } = useNIP44DM({ identity });
  
  // Check scam reports for the active chat partner or vendor
  const activeTargetPubkey = activeDm || (activeGroup ? activeGroup.creator : null);
  const { isScammer } = useScamReports({ identity, targetPubkey: activeTargetPubkey });
  const rawGroupMembers = useChatStore(s => s.groupMembers);
  const groupMembers = Array.isArray(rawGroupMembers) ? rawGroupMembers : [];
  const { sendGroupMessage, subscribeToGroups, pinMessage, unpinMessage, fetchPinnedMessage, requestGroupKey, addMember, kickMember , updateGroupSettings , promoteMember } = useNIP29Group({ identity });
  const { sendReaction, subscribeToReactions } = useReactions({ identity });
  const { sendReview } = useReputation({ identity });
  // Fetch reactions when switching chats
  useEffect(() => {
    let cleanup = null;
    if (view === 'dm' && activeDm && dms[activeDm]) {
      const ids = dms[activeDm].map(m => m.id).filter(Boolean);
      if (ids.length > 0) cleanup = subscribeToReactions(ids);
    }
    if (view === 'group' && activeGroup && groupMessages[activeGroup.id]) {
      const ids = groupMessages[activeGroup.id].map(m => m.id).filter(Boolean);
      if (ids.length > 0) cleanup = subscribeToReactions(ids);
    }
    return () => { if (cleanup) cleanup(); };
  }, [view, activeDm, activeGroup?.id, subscribeToReactions]);

  useEffect(() => {
    if (activeGroup?.id) {
      fetchPinnedMessage(activeGroup.id);
    }
  }, [activeGroup?.id]);

  
  
  
  
  
  const [lockedUsername, setLockedUsername] = useState(localStorage.getItem('cipher_my_username') || '');

  // Restore @username from relay on login (localStorage is wiped on account switch)
  useEffect(() => {
    if (identity?.pk) openDBFor(identity.pk);
  }, [identity?.pk]);

  useEffect(() => {
    if (!identity?.pk) return;
    const fetchMyUsername = async () => {
      try {
        const pool = await getAuthenticatedPool(identity);
        const evs = await queryWithTimeout(pool, generalRelays, {
          kinds: [30078],
          authors: [identity.pk],
          '#d': ['username']
        });
        if (evs && evs.length > 0) {
          const ev = evs[0];
          const username = ev.tags.find(t => t[0] === 'username')?.[1];
          if (username && username !== lockedUsername) {
            setLockedUsername(username);
            localStorage.setItem('cipher_my_username', username);
            setMyUsername(username);
          }
        }
      } catch (e) { console.error('Failed to restore username', e); }
    };
    fetchMyUsername();
  }, [identity?.pk]);
  
  
  
  

  
  
  
  
  
  
  
  
  
  const scrollRef = useRef(null);
  const poolRef = useRef(null);
  const lastTypingSent = useRef(0);

   
  
  
  
  
  
  
   
  
  
  const [replyText, setReplyText] = useState('')
  
  const [forwardingMsg, setForwardingMsg] = useState(null)
  const [showForwardModal, setShowForwardModal] = useState(false)
  const [showEmojiPicker, setShowEmojiPicker] = useState(false)

  
  
  
  
  
  
  
  

  useEffect(() => {
    localStorage.setItem('cipher_my_products', JSON.stringify(myProducts));
  }, [myProducts]);
  
  
  
  

  const fetchGroupMembers = async (id) => {
    try {
      const pool = await getAuthenticatedPool(identity);
      const evs = await queryWithTimeout(pool, groupRelays, { kinds: [39002], '#d': [id], '#h': [id] });
      let m = [];
      if (evs.length) {
        const t = evs[0].tags.filter(x => x[0] === 'p');
        m = t.map(x => ({ pubkey: x[1], role: x[2] || 'member' }));
        fetchProfilesForPubkeys(m.map(x => x.pubkey));
      }
      if (!Array.isArray(m)) m = [];
      if (!m.find(x => x.pubkey === identity.pk)) {
        m.push({ pubkey: identity.pk, role: activeGroup?.creator === identity.pk ? 'admin' : 'member' });
      }
      setGroupMembers(m);
    } catch (err) {
      console.error(err);
      setGroupMembers([]); // Safe fallback
    }
  };

  useEffect(() => {
    if (showGroupInfo && activeGroup) {
      fetchGroupMembers(activeGroup.id);
    }
  }, [showGroupInfo, activeGroup]);

  useEffect(() => {
    if (view === 'group' && activeGroup?.id) {
      // Initial fetch on open
      fetchGroupMembers(activeGroup.id);
      // Slow polling as safety net — WS subscription is the primary source
      const interval = setInterval(() => {
        fetchGroupMembers(activeGroup.id);
      }, 30000);
      return () => clearInterval(interval);
    }
  }, [view, activeGroup?.id]);

  useEffect(() => {
    if (view === 'group' && activeGroup?.id) {
      import('./lib/crypto/groupKeyStore').then(({ getCurrentGroupKey }) => {
        getCurrentGroupKey(activeGroup.id).then(key => {
          if (!key) requestGroupKey(activeGroup.id);
        });
      });
    }
  }, [view, activeGroup?.id, requestGroupKey]);

  // Send typing indicator in DMs
  useEffect(() => {
    if (!newMessage.trim() || view !== 'dm' || !activeDm || !identity.sk) return;
    const now = Date.now();
    if (now - lastTypingSent.current < 2500) return;
    
    const timer = setTimeout(async () => {
      try {
        const { finalizeEvent, nip44 } = await import('nostr-tools');
        const pool = await getAuthenticatedPool(identity);
        const shared = nip44.v2.utils.getConversationKey(identity.sk, activeDm);
        const encrypted = nip44.v2.encrypt(JSON.stringify({ type: 'typing' }), shared);
        
        const ev = finalizeEvent({
          kind: 4, // Use kind 4 so strict relays accept it
          created_at: Math.floor(Date.now() / 1000),
          tags: [['p', activeDm]],
          content: encrypted
        }, identity.sk);
        
        pool.publish(generalRelays, ev);
        lastTypingSent.current = Date.now();
      } catch (e) {}
    }, 200); // Wait 200ms to send (feels instant)
    
    return () => clearTimeout(timer);
  }, [newMessage, view, activeDm, identity.sk]);

  // Send typing indicator in Groups
  useEffect(() => {
    if (!newMessage.trim() || view !== 'group' || !activeGroup || !identity.sk) return;
    const now = Date.now();
    if (now - lastTypingSent.current < 2500) return;
    
    const timer = setTimeout(async () => {
      try {
        const { finalizeEvent } = await import('nostr-tools');
        const pool = await getAuthenticatedPool(identity);
        
        const typingPayload = JSON.stringify({ type: 'typing' });
        const ev = finalizeEvent({
          kind: 9,
          created_at: Math.floor(Date.now() / 1000),
          tags: [['h', activeGroup.id]],
          content: typingPayload
        }, identity.sk);
        
        pool.publish(groupRelays, ev);
        lastTypingSent.current = Date.now();
      } catch (e) {}
    }, 200);
    
    return () => clearTimeout(timer);
  }, [newMessage, view, activeGroup, identity.sk]);

  // Clean up typing users + purge stale typing events from Dexie (audit H6)
  useEffect(() => {
    const interval = setInterval(() => {
      const now = Date.now();
      // Purge typing messages older than 30s from every group in Dexie
      import('./db').then(({ db }) => {
        const cutoff = Math.floor(Date.now() / 1000) - 30;
        db.messages.where('timestamp').below(cutoff).toArray().then(msgs => {
          msgs.forEach(m => {
            if (m.rawContent) {
              try {
                const p = JSON.parse(m.rawContent);
                if (p?.type === 'typing') db.messages.delete(m.id).catch(() => {});
              } catch (e) {}
            }
          });
        }).catch(() => {});
      });
      
      setTypingUsers(prev => {
        const next = { ...prev };
        let changed = false;
        for (const pk in next) {
          if (now - next[pk] > 2500) { delete next[pk]; changed = true; }
        }
        return changed ? next : prev;
      });

      setGroupTypingUsers(prev => {
        const next = { ...prev };
        let changed = false;
        for (const pk in next) {
          if (now - next[pk] > 2500) { delete next[pk]; changed = true; }
        }
        return changed ? next : prev;
      });
    }, 1000);
    return () => clearInterval(interval);
  }, []);

  // Force fetch profiles for active group members
  useEffect(() => {
    if (activeGroup && groupMessages[activeGroup.id]) {
      const pks = new Set(groupMessages[activeGroup.id].map(m => m.pubkey));
      if (pks.size > 0) fetchProfilesForPubkeys([...pks]);
    }
  }, [activeGroup, groupMessages]);

  
  useEffect(() => {
    if (!identity?.sk) return;
    fetchGroups().catch((e) => console.error('[init] fetchGroups:', e));
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [identity?.sk]);

  const sortMessages = (a, b) => {
    // Prefer local millisecond timestamp, fallback to relay seconds
    const timeA = a.local_timestamp || (a.timestamp * 1000);
    const timeB = b.local_timestamp || (b.timestamp * 1000);
    if (timeA !== timeB) return timeA - timeB;
    return (a.id || '').localeCompare(b.id || '');
  };

  const canPost = !activeGroup?.isChannel || activeGroup?.creator === identity?.pk;

  const _durationSecs = (timerStr) => {
    if (!timerStr || timerStr === 'off') return 0;
    if (timerStr.endsWith('m')) return parseInt(timerStr) * 60 || 0;
    if (timerStr === '1h') return 3600;
    if (timerStr === '24h') return 86400;
    if (timerStr === '7d') return 604800;
    return 0;
  };

  const _ORDER_ACTIONS = ['accept_order', 'decline_order', 'mark_shipped', 'cancel_order', 'confirm_payment', 'confirm_delivery', 'report_issue'];
  const _validateOrderAction = (action, msg) => {
    if (!msg) return false;
    const dataType = msg.data?.type || (() => { try { return JSON.parse(msg.rawContent || '{}').type; } catch { return null; } })();
    if (dataType !== 'order_request' && dataType !== 'order_update') return false;
    // Basic rule: ship/decline/accept only from vendor side; paid/confirm/dispute only from buyer side
    if (['accept_order', 'decline_order', 'mark_shipped'].includes(action)) {
      return msg.isSender === false; // vendor receives order_request from buyer
    }
    if (['confirm_payment', 'confirm_delivery', 'report_issue', 'cancel_order'].includes(action)) {
      return msg.isSender === true || !msg.isSender; // buyer can be either side of the coin
    }
    return true;
  };

  const handleMessageAction = async (action, secondArg = null) => {
    // secondArg can be: null (use selectedMessage), an emoji string (for 'react'), or a full msg object (for direct button clicks)
    let msg;
    let emojiOverride = null;
    if (secondArg && typeof secondArg === 'object' && secondArg.id && secondArg.pubkey) {
      msg = secondArg;
    } else if (typeof secondArg === 'string') {
      emojiOverride = secondArg;
      msg = selectedMessage;
    } else {
      msg = selectedMessage;
    }
    if (!msg) return;

    if (action === 'react' && emojiOverride) {
      await sendReaction(msg.id, emojiOverride, !!activeGroup, activeGroup?.id, msg.pubkey);
      setSelectedMessage(null); return;
    }
    if (action === 'reply') { setReplyingTo(msg); setSelectedMessage(null); return; }
    if (action === 'copy') { copyToClipboard(msg.data?.message || msg.rawContent || msg.text || ''); setToast({ type: 'success', message: 'Copied' }); setSelectedMessage(null); return; }
    if (action === 'forward') {
      const senderName = profiles[msg.pubkey]?.displayName || profiles[msg.pubkey]?.name || (msg.pubkey === identity.pk ? 'You' : `User ${msg.pubkey.slice(0,4)}`);
      setForwardingMsg({ data: msg.data || { type: 'text', message: msg.rawContent }, originalSenderName: senderName, id: msg.id });
      setSelectedMessage(null); return;
    }
    if (action === 'bookmark') {
      const chatId = activeDm || activeGroup?.id;
      if (chatId) {
        useChatStore.getState().toggleBookmark(chatId, msg.id);
        const isBm = useChatStore.getState().isBookmarked(chatId, msg.id);
        setToast({ type: 'success', message: isBm ? 'Saved' : 'Unsaved' });
      }
      setSelectedMessage(null); return;
    }
    if (action === 'select') {
      useChatStore.getState().toggleSelectionMode();
      useChatStore.getState().toggleSelectedMsg(msg.id);
      setSelectedMessage(null); return;
    }
    if (action === 'edit') {
      useChatStore.getState().openDialog({
        title: 'Edit Message', hasInput: true, inputDefault: msg.text || msg.data?.message || '',
        onConfirm: async (newText) => {
          if (!newText || newText === msg.text) return;
          useChatStore.getState().addMessageEdit(msg.id, { previousText: msg.text || msg.data?.message || '' });
          try {
            const { db } = await import('./db');
            const original = await db.messages.get(msg.id);
            if (original) {
              const updated = { ...original, data: { ...original.data, message: newText, edited: true }, edited: true };
              await db.messages.put(updated);
              if (activeDm) setDms(prev => ({ ...prev, [activeDm]: (prev[activeDm] || []).map(m => m.id === msg.id ? updated : m) }));
              else if (activeGroup) setGroupMessages(prev => ({ ...prev, [activeGroup.id]: (prev[activeGroup.id] || []).map(m => m.id === msg.id ? updated : m) }));
            }
          } catch (e) { console.error(e); }
        }
      });
      setSelectedMessage(null); return;
    }
    if (action === 'delete') {
      try {
        const { finalizeEvent } = await import('nostr-tools');
        const pool = await getAuthenticatedPool(identity);
        const ev = finalizeEvent({ kind: 5, created_at: Math.floor(Date.now() / 1000), tags: [['e', msg.id]], content: 'Deleted' }, identity.sk);
        await Promise.allSettled(pool.publish(generalRelays, ev));
        setDeletedMsgs(prev => new Set(prev).add(msg.id));
        setToast({ type: 'success', message: 'Deleted' });
      } catch (e) { setToast({ type: 'error', message: 'Delete failed' }); }
      setSelectedMessage(null); return;
    }
    if (action === 'pin' && activeGroup) { await pinMessage(activeGroup.id, msg.id); setToast({ type: 'success', message: 'Pinned' }); setSelectedMessage(null); return; }
    if (action === 'report_scam' || action === 'report') {
      try {
        const { finalizeEvent } = await import('nostr-tools');
        const pool = await getAuthenticatedPool(identity);
        const ev = finalizeEvent({ kind: 1984, created_at: Math.floor(Date.now() / 1000), tags: [['p', msg.pubkey], ['report', 'scam'], ['e', msg.id]], content: 'Reported' }, identity.sk);
        await Promise.allSettled(pool.publish(generalRelays, ev));
        setToast({ type: 'success', message: 'Report submitted' });
      } catch (e) { setToast({ type: 'error', message: 'Report failed' }); }
      setSelectedMessage(null); return;
    }
    if (action === 'view_vendor') { setVendorStorefrontPubkey(msg.pubkey); setSelectedMessage(null); return; }
    if (action === 'buy_product') {
      haptic('medium');
      const vendorPk = msg.pubkey;
      openChat('dm', vendorPk);
      setSelectedMessage(null);
      setTimeout(async () => {
        const payload = {
          type: 'order_request', status: 'pending',
          product: { id: msg.id, title: msg.data.title, priceUsd: msg.data.priceUsd, image: msg.data.image, description: msg.data.description }
        };
        const { sendDM } = useNIP44DM({ identity });
        await sendDM(vendorPk, payload);
        await saveMessage(vendorPk, { id: `temp-${Date.now()}`, isSender: true, timestamp: Math.floor(Date.now() / 1000), data: payload, pubkey: identity.pk, isGroup: false });
      }, 300);
      return;
    }
    if (action === 'broadcast_product') { setBroadcastProduct(msg.data); setSelectedMessage(null); return; }
    if (action === 'edit_product') { setEditingProduct({ msg, product: msg.data }); setSelectedMessage(null); return; }
    if (action === 'mark_sold_out') {
      try {
        const updatedPayload = { ...(msg.data || {}), soldOut: true };
        if (activeGroup) await sendGroupMessage(activeGroup.id, updatedPayload);
        setToast({ type: 'success', message: 'Marked sold out' });
      } catch (e) { setToast({ type: 'error', message: 'Failed' }); }
      setSelectedMessage(null); return;
    }
    if (action === 'accept_order') {
      if (!_validateOrderAction('accept_order', msg)) {
        setToast({ type: 'error', message: 'Only the vendor can accept orders' });
        setSelectedMessage(null);
        return;
      }
      const btc = localStorage.getItem('cipher_btc_address') || '';
      const xmr = localStorage.getItem('cipher_xmr_address') || '';
      if (!btc && !xmr) { setToast({ type: 'error', message: 'Set payment addresses in Profile first' }); setSelectedMessage(null); return; }
      const payload = { type: 'order_update', orderId: msg.id, productName: msg.data.product?.title || msg.data.productName, status: 'accepted', paymentMethods: { btc: btc || null, xmr: xmr || null } };
      await sendDM(msg.pubkey, payload);
      updateLocalOrder(msg.pubkey, msg.id, { status: 'accepted', paymentMethods: payload.paymentMethods });
      setToast({ type: 'success', message: 'Order accepted' });
      setSelectedMessage(null); return;
    }
    if (action === 'decline_order' || action === 'cancel_order') {
      const payload = { type: 'order_update', orderId: msg.id, productName: msg.data.product?.title, status: 'cancelled' };
      await sendDM(msg.pubkey, payload);
      updateLocalOrder(msg.pubkey, msg.id, { status: 'cancelled' });
      setToast({ type: 'success', message: 'Order cancelled' });
      setSelectedMessage(null); return;
    }
    if (action === 'confirm_payment') {
      const payload = { type: 'order_update', orderId: msg.id, productName: msg.data.product?.title || msg.data.productName, status: 'paid', shippingAddress: msg.data.shippingAddress };
      await sendDM(msg.pubkey, payload);
      updateLocalOrder(msg.pubkey, msg.id, { status: 'paid', shippingAddress: msg.data.shippingAddress });
      setToast({ type: 'success', message: 'Payment confirmed' });
      setSelectedMessage(null); return;
    }
    if (action === 'mark_shipped') {
      const tracking = msg.data?.tracking || '';
      const payload = { type: 'order_update', orderId: msg.id, productName: msg.data.product?.title || msg.data.productName, status: 'shipped', tracking };
      await sendDM(msg.pubkey, payload);
      updateLocalOrder(msg.pubkey, msg.id, { status: 'shipped', tracking });
      setToast({ type: 'success', message: tracking ? 'Shipped' : 'Marked shipped' });
      setSelectedMessage(null); return;
    }
    if (action === 'confirm_delivery') {
      const payload = { type: 'order_update', orderId: msg.id, productName: msg.data.product?.title || msg.data.productName, status: 'completed' };
      await sendDM(msg.pubkey, payload);
      updateLocalOrder(msg.pubkey, msg.id, { status: 'completed' });
      try {
        const { finalizeEvent } = await import('nostr-tools');
        const pool = await getAuthenticatedPool(identity);
        const vouchEv = finalizeEvent({ kind: 10004, created_at: Math.floor(Date.now() / 1000), tags: [['p', msg.pubkey], ['vouch', 'true'], ['for', msg.data.product?.title || 'transaction']], content: 'Auto-vouch from completed delivery' }, identity.sk);
        await Promise.allSettled(pool.publish(generalRelays, vouchEv));
      } catch (e) {}
      setToast({ type: 'success', message: 'Delivered' });
      setSelectedMessage(null); return;
    }
    if (action === 'report_issue') {
      useChatStore.getState().openDialog({
        title: 'Report an Issue', hasInput: true, placeholder: 'e.g. Not shipped, wrong item, damaged',
        type: 'danger', confirmText: 'Submit',
        onConfirm: async (reason) => {
          if (!reason || !reason.trim()) return;
          const payload = { type: 'order_update', orderId: msg.id, productName: msg.data.product?.title, status: 'disputed', disputeReason: reason.trim() };
          await sendDM(msg.pubkey, payload);
          updateLocalOrder(msg.pubkey, msg.id, { status: 'disputed', disputeReason: reason.trim() });
          setToast({ type: 'success', message: 'Issue reported' });
        }
      });
      setSelectedMessage(null); return;
    }
    setSelectedMessage(null);
  };

  const handleForwardSubmit = async (targetId, isGroup) => {
    if (!forwardingMsg) return;
    const data = forwardingMsg.data || {};
    
    try {
      if (isGroup) {
        await sendGroupMessage(targetId, data, null, null);
      } else {
        await sendDM(targetId, data, null, null);
      }
      setToast({ type: 'success', message: 'Message forwarded!' });
      setForwardingMsg(null);
    } catch (e) {
      console.error('Forward failed:', e);
      setToast({ type: 'error', message: 'Failed to forward message' });
    }
  };

  const fetchChats = async (showLoader = false) => {
    if (showLoader) setLoading(true);
    try {
      const pool = await getAuthenticatedPool(identity)
      
      // Use Promise.all to fetch everything in parallel so it's faster
      // Fetch group metadata + DMs + reactions in parallel
      const [sentDms, recvDms, groupMetaEvents, reactionsEvents, delEvents] = await Promise.all([
        queryWithTimeout(pool, generalRelays, { kinds: [4], authors: [identity.pk], limit: 50 }),
        queryWithTimeout(pool, generalRelays, { kinds: [4], '#p': [identity.pk], limit: 50 }),
        queryWithTimeout(pool, groupRelays, { kinds: [39000, 9002], limit: 100 }),
        queryWithTimeout(pool, generalRelays, { kinds: [7], limit: 500 }),
        queryWithTimeout(pool, generalRelays, { kinds: [5], limit: 100 })
      ]);

      // Parse groups FIRST so we know what group IDs to fetch messages for
      const localGroupsNow = getMyGroups(identity.pk);
      const uniqueGroupsNow = Array.from(new Map(groupMetaEvents.map(ev => {
        const hTag = ev.tags.find(t => t[0] === 'h')?.[1] || ev.tags.find(t => t[0] === 'd')?.[1];
        return [hTag, ev];
      })).values());
      const parsedGroupsNow = uniqueGroupsNow.map(ev => {
        const getTag = (t) => ev.tags.find(x => x[0] === t)?.[1];
        return {
          id: getTag('h') || getTag('d'),
          name: getTag('name') || 'Unnamed',
          about: getTag('about') || '',
          isChannel: ev.tags.some(t => t[0] === 'channel' || t[0] === 'broadcast'),
          creator: ev.pubkey
        };
      }).filter(g => g.id);
      const allGroupIds = Array.from(new Set([
        ...localGroupsNow.map(g => g.id),
        ...parsedGroupsNow.map(g => g.id)
      ]));

      // Now fetch group messages with the correct IDs
      const allMsgs = allGroupIds.length > 0
        ? await queryWithTimeout(pool, groupRelays, { kinds: [9], '#h': allGroupIds, limit: 500 })
        : [];

      const allDms = Array.from(new Map([...sentDms, ...recvDms].map(ev => [ev.id, ev])).values())
      
      const { nip44 } = await import('nostr-tools')
      for (const ev of allDms) {
        try {
          const isSender = ev.pubkey === identity.pk
          const counterparty = isSender ? ev.tags.find(t => t[0] === 'p')?.[1] : ev.pubkey
          if (!counterparty) continue
          
          const shared = nip44.v2.utils.getConversationKey(identity.sk, counterparty)
          const text = nip44.v2.decrypt(ev.content, shared)
          let data = {}; try { data = JSON.parse(text) } catch (e) { data = { type: 'text', message: text } }
          
          // ✅ FIX: Ignore system events so they don't pollute the chat list
          if (data.type === 'typing' || data.type === 'read' || data.type === 'pin') continue;

          const replyTag = ev.tags.find(t => t[0] === 'e' && t[3] === 'reply')
          const clientId = ev.tags.find(t => t[0] === 'client')?.[1]

          await saveMessage(counterparty, {
            id: ev.id, clientId, isSender, timestamp: ev.created_at, data, pubkey: ev.pubkey, replyTo: replyTag ? replyTag[1] : null,
            isGroup: false // ✅ Explicitly mark as DM
          });
        } catch (e) {}
      }

      const uniqueGroups = Array.from(new Map(groupMetaEvents.map(ev => {
        const hTag = ev.tags.find(t => t[0] === 'h')?.[1] || ev.tags.find(t => t[0] === 'd')?.[1];
        return [hTag, ev]
      })).values())
      
      const parsedGroups = uniqueGroups.map(ev => {
        const getTag = (t) => ev.tags.find(x => x[0] === t)?.[1];
        return {
          id: getTag('h') || getTag('d'),
          name: getTag('name') || 'Unnamed',
          about: getTag('about') || '',
          isChannel: ev.tags.some(t => t[0] === 'channel' || t[0] === 'broadcast'),
          creator: ev.pubkey
        }
      }).filter(g => g.id)
      const localGroups = getMyGroups(identity.pk);
      const allGroupsMap = new Map(localGroups.map(g => [g.id, g]));
      
      parsedGroups.forEach(pg => {
        if (allGroupsMap.has(pg.id)) {
          // Overwrite the local group with the real metadata (fixes the "Group d1c..." name)
          allGroupsMap.set(pg.id, { ...allGroupsMap.get(pg.id), ...pg });
        } else {
          allGroupsMap.set(pg.id, pg);
        }
      });
      
      const finalGroupsList = Array.from(allGroupsMap.values());
      setGroups(finalGroupsList);

      for (const ev of allMsgs) {
        const groupId = ev.tags.find(t => t[0] === 'e')?.[1]
        if (!groupId) continue
        const replyTag = ev.tags.find(t => t[0] === 'e' && t[3] === 'reply')
        const clientId = ev.tags.find(t => t[0] === 'client')?.[1]
        
        await saveMessage(groupId, {
          id: ev.id, clientId, isSender: ev.pubkey === identity.pk, pubkey: ev.pubkey, timestamp: ev.created_at, rawContent: ev.content, replyTo: replyTag ? replyTag[1] : null,
          isGroup: true // ✅ Explicitly mark as Group
        });
      }

      
      const reactionMap = {}
      reactionsEvents.forEach(ev => {
        const targetId = ev.tags.find(t => t[0] === 'e')?.[1]
        if (targetId) {
          if (!reactionMap[targetId]) reactionMap[targetId] = []
          if (!reactionMap[targetId].find(r => r.pubkey === ev.pubkey && r.emoji === ev.content)) {
            reactionMap[targetId].push({ emoji: ev.content, pubkey: ev.pubkey })
          }
        }
      })
      setReactions(reactionMap)

      const deleted = new Set()
      delEvents.forEach(ev => {
        if (ev.pubkey === identity.pk) {
          const targetId = ev.tags.find(t => t[0] === 'e')?.[1]
          if (targetId) deleted.add(targetId)
        }
      })
      setDeletedMsgs(deleted)

      // Load from Dexie
      const allDbMsgs = await db.messages.toArray()
      
      // Calculate unread counts
      const reads = await db.chatReads.toArray();
      const readMap = {};
      reads.forEach(r => readMap[r.chatId] = r.lastRead);
      
      const counts = {};
      allDbMsgs.forEach(msg => {
        if (!msg.isSender) {
          const lastRead = readMap[msg.chatId] || 0;
          if (msg.timestamp > lastRead) {
            counts[msg.chatId] = (counts[msg.chatId] || 0) + 1;
          }
        }
      });
      setUnreadCounts(counts);

      const finalDms = {}
      const finalGroups = {}
      
      for (const msg of allDbMsgs) {
        if (msg.isGroup === true) {
          if (!finalGroups[msg.chatId]) finalGroups[msg.chatId] = []
          finalGroups[msg.chatId].push(msg)
        } else {
          if (!finalDms[msg.chatId]) finalDms[msg.chatId] = []
          finalDms[msg.chatId].push(msg)
        }
      }

      Object.keys(finalDms).forEach(k => finalDms[k].sort(sortMessages))
      Object.keys(finalGroups).forEach(k => finalGroups[k].sort(sortMessages))

      setDms(finalDms)
      setGroupMessages(finalGroups)

      // Kick off profile loading for all DM counterparties
      const dmPubkeys = Object.keys(finalDms);
      if (dmPubkeys.length > 0) {
        fetchProfilesForPubkeys(dmPubkeys);
      }

    } catch (err) { 
      console.error("Fetch error:", err) 
    } finally { 
      setLoading(false) 
    }
  }

  // ✅ SILENT BACKGROUND POLLER (Safety net for dropped WebSockets)

  const fetchProfilesForPubkeys = async (pubkeys) => {
    if (!pubkeys || pubkeys.length === 0) return;
    try {
      // 1. Load whatever we already have cached in Dexie
      const cached = await db.profiles.bulkGet(pubkeys);
      const cachedMap = {};
      cached.forEach(p => { if (p) cachedMap[p.pubkey] = p; });
      setProfiles(prev => ({ ...prev, ...cachedMap }));

      // 2. Fetch the rest from relays
      const missing = pubkeys.filter(pk => !cachedMap[pk]);
      if (missing.length === 0) return;

      const pool = await getAuthenticatedPool(identity);
      const allRelays = [...new Set([...generalRelays, ...groupRelays])];
      const events = await queryWithTimeout(
        pool,
        allRelays,
        { kinds: [0], authors: missing },
        4000
      );

      const fresh = {};
      for (const ev of events) {
        try {
          const meta = JSON.parse(ev.content);
          const profile = {
            pubkey: ev.pubkey,
            name: meta.name || meta.display_name || ev.pubkey.slice(0, 8),
            displayName: meta.display_name || meta.name || ev.pubkey.slice(0, 8),
            picture: meta.picture || null,
            about: meta.about || ''
          };
          fresh[ev.pubkey] = profile;
          await db.profiles.put(profile);
        } catch (e) {}
      }
      if (Object.keys(fresh).length > 0) {
        setProfiles(prev => ({ ...prev, ...fresh }));
        console.log(`[profiles] fetched ${Object.keys(fresh).length} fresh profiles`);
      }
    } catch (err) {
      console.error("[profiles] fetch failed:", err);
    }
  };

    useEffect(() => {
    if (!identity.sk) return;
    
    let cleanupDMs = null;
    let cleanupGroups = null;
    
    const setup = async () => {
      const pool = await getAuthenticatedPool(identity);
      poolRef.current = pool;
      const since = Math.floor(Date.now() / 1000) - 604800; // 7 days back
      
      await fetchChats(true);
      
      // Subscribe to DMs
      cleanupDMs = subscribeToDMs(since);
      
      // Subscribe to Groups
      const groupIds = groups.map(g => g.id);
      if (groupIds.length > 0) {
        cleanupGroups = subscribeToGroups(groupIds, since);
      }
    };
    
    setup();
    
    return () => {
      if (cleanupDMs) cleanupDMs();
      if (cleanupGroups) cleanupGroups();
    };
  }, [identity.sk, identity.pk, groups.length])

  useEffect(() => {
    if (scrollRef.current) {
      scrollRef.current.scrollTop = scrollRef.current.scrollHeight;
    }
  }, [dms, activeDm, groupMessages, activeGroup, reactions, replyingTo, typingUsers])

  const handleImageUpload = async (e) => {
    const files = Array.from(e.target.files || []);
    if (files.length === 0) return;
    
    setUploadingImage(true);
    const caption = newMessage; 
    setNewMessage(''); // Clear input instantly
    
    try {
      const urls = [];
      for (const file of files) {
        const compressedFile = await compressImage(file);
        const cleanFile = await stripImageMetadata(compressedFile);
        const blob = await uploadToBlossom(cleanFile, {
          signer: {
            getPublicKey: async () => identity.pk,
            signEvent: async (event) => {
              const { finalizeEvent } = await import('nostr-tools')
              return finalizeEvent(event, identity.sk)
            }
          },
        });
        urls.push(blob.url);
      }
      
      await sendMessage(caption, false, null, urls);
      setToast({ type: 'success', message: urls.length > 1 ? "Album sent!" : "Image sent!" });
    } catch (err) {
      console.error(err);
      setToast({ type: 'error', message: "Upload failed" });
    } finally {
      setUploadingImage(false);
      if (fileInputRef.current) fileInputRef.current.value = '';
    }
  }

  const startRecording = async () => {
    try {
      const stream = await navigator.mediaDevices.getUserMedia({ audio: true })
      const mediaRecorder = new MediaRecorder(stream)
      mediaRecorderRef.current = mediaRecorder
      audioChunksRef.current = []

      mediaRecorder.ondataavailable = (e) => {
        if (e.data.size > 0) audioChunksRef.current.push(e.data)
      }

      mediaRecorder.onstop = async () => {
        const audioBlob = new Blob(audioChunksRef.current, { type: 'audio/webm' })
        const file = new File([audioBlob], 'voice_note.webm', { type: 'audio/webm' })
        
        setUploadingImage(true)
        setToast({ type: 'success', message: "Uploading voice note..." })
        
        try {
          const blob = await uploadToBlossom(file, {
            signer: {
              getPublicKey: async () => identity.pk,
              signEvent: async (event) => {
                const { finalizeEvent } = await import('nostr-tools')
                return finalizeEvent(event, identity.sk)
              }
            },
          })
          await sendMessage('', false, blob.url)
          setToast({ type: 'success', message: "Voice note sent!" })
        } catch (err) {
          console.error(err)
          setToast({ type: 'error', message: "Voice upload failed" })
        } finally {
          setUploadingImage(false)
        }
      }

      mediaRecorder.start()
      setIsRecording(true)
    } catch (err) {
      console.error(err)
      setToast({ type: 'error', message: "Microphone access denied" })
    }
  }

  const stopRecording = () => {
    if (mediaRecorderRef.current && isRecording) {
      mediaRecorderRef.current.stop()
      mediaRecorderRef.current.stream.getTracks().forEach(track => track.stop())
      setIsRecording(false)
    }
  }

  useGroupKeyReconciler({
    groupId: activeGroup?.id || null,
    members: (Array.isArray(groupMembers) ? groupMembers : []).map(m => m.pubkey),
    isOwner: activeGroup?.creator === identity?.pk,
    identity,
  });

  // Disappearing Messages Sweeper
  const disappearingTimers = useChatStore(s => s.disappearingTimers);
  useEffect(() => {
    const interval = setInterval(async () => {
      const now = Math.floor(Date.now() / 1000);
      
      // Sweep DMs
      setDms(prev => {
        let changed = false;
        const next = { ...prev };
        for (const [pk, msgs] of Object.entries(prev)) {
          const timerStr = disappearingTimers[pk];
          if (timerStr && timerStr !== 'off') {
            let seconds = 0;
            if (timerStr.endsWith('m')) seconds = parseInt(timerStr) * 60;
            else if (timerStr === '1h') seconds = 3600;
            else if (timerStr === '24h') seconds = 86400;
            else if (timerStr === '7d') seconds = 604800;
            
            if (seconds > 0) {
              const filtered = msgs.filter(m => (now - m.timestamp) < seconds);
              if (filtered.length !== msgs.length) {
                next[pk] = filtered;
                changed = true;
              }
            }
          }
        }
        return changed ? next : prev;
      });
      
      // Sweep Groups
      setGroupMessages(prev => {
        let changed = false;
        const next = { ...prev };
        for (const [gid, msgs] of Object.entries(prev)) {
          const timerStr = disappearingTimers[gid];
          if (timerStr && timerStr !== 'off') {
            let seconds = 0;
            if (timerStr.endsWith('m')) seconds = parseInt(timerStr) * 60;
            else if (timerStr === '1h') seconds = 3600;
            else if (timerStr === '24h') seconds = 86400;
            else if (timerStr === '7d') seconds = 604800;
            
            if (seconds > 0) {
              const filtered = msgs.filter(m => (now - m.timestamp) < seconds);
              if (filtered.length !== msgs.length) {
                next[gid] = filtered;
                changed = true;
              }
            }
          }
        }
        return changed ? next : prev;
      });
    }, 5000); // Check every 5 seconds
    return () => clearInterval(interval);
  }, [disappearingTimers, setDms, setGroupMessages]);

  const handlePostListing = async (listingData) => {
    if (!postListingGroup) return;
    const payload = {
      type: 'product',
      title: listingData.title,
      priceUsd: listingData.priceUsd,
      image: listingData.image,
      description: listingData.description,
      dropUntil: listingData.dropUntil || null,
      stock: listingData.stock || null
    };
    const res = await sendGroupMessage(postListingGroup.id, payload);
    if (res.success) {
      setToast({ type: 'success', message: 'Listing posted to group!' });
    } else {
      setToast({ type: 'error', message: 'Failed to post listing' });
    }
  };

  const handleBroadcastSubmit = async (groupIds, product) => {
    const payload = {
      type: 'product',
      title: product.title,
      priceUsd: product.priceUsd,
      image: product.image,
      description: product.description
    };
    let successCount = 0;
    for (const gid of groupIds) {
      try {
        const res = await sendGroupMessage(gid, payload);
        if (res.success) successCount++;
      } catch (e) {}
    }
    setToast({ type: 'success', message: `Broadcast to ${successCount} group${successCount !== 1 ? 's' : ''}!` });
    setBroadcastProduct(null);
  };

  const updateLocalOrder = (peerPubkey, orderId, updateData) => {
    useChatStore.getState().setDms(prev => {
      const msgs = prev[peerPubkey] || [];
      const updated = msgs.map(m => {
        if (m.id === orderId) {
          return { ...m, data: { ...m.data, ...updateData } };
        }
        return m;
      });
      return { ...prev, [peerPubkey]: updated };
    });
  };

  const handleSaveEditedProduct = async (updatedProduct) => {
    if (!editingProduct) return;
    try {
      const { msg } = editingProduct;
      const payload = {
        type: 'product',
        title: updatedProduct.title,
        priceUsd: updatedProduct.priceUsd,
        image: updatedProduct.image,
        description: updatedProduct.description,
        updatedFrom: msg.id
      };
      
      // If the original message was in a group, republish to that group
      if (msg.isGroup && activeGroup) {
        await sendGroupMessage(activeGroup.id, payload);
      } else if (activeDm) {
        await sendDM(activeDm, payload);
      }
      
      setToast({ type: 'success', message: 'Product updated!' });
      setEditingProduct(null);
    } catch (e) {
      setToast({ type: 'error', message: 'Failed to update product' });
    }
  };

  const sendMessage = async (text, isImage = false, audioUrl = null, imageUrls = null, customPayload = null) => {
    if (!text.trim() && !audioUrl && !customPayload && !imageUrls) return
    haptic('light');
    const tempId = `temp-${Date.now()}`
    
    let msgPayload = { type: 'text', message: text }
    if (isImage) msgPayload = { type: 'image', url: text, metadata_stripped: true }
    if (audioUrl) msgPayload = { type: 'audio', url: audioUrl }
    if (imageUrls) msgPayload = { type: 'album', urls: imageUrls, message: text }
    if (customPayload) msgPayload = customPayload;

    // Attach expiry from active disappearing timer (audit H9)
    const _chatIdForTimer = (view === 'dm' ? activeDm : activeGroup?.id);
    const _timerStr = useChatStore.getState().disappearingTimers?.[_chatIdForTimer];
    const _secs = _durationSecs(_timerStr);
    if (_secs > 0 && !msgPayload.expires_at) {
      msgPayload.expires_at = Math.floor(Date.now() / 1000) + _secs;
    }
    
    const replyId = replyingTo ? replyingTo.id : null
    
    // ✅ STRICT ROUTING: Only use activeDm if we are actually in the DM view
    const isDmView = view === 'dm';
    const chatId = isDmView ? activeDm : activeGroup?.id;

    const newMsg = { 
      id: tempId, clientId: tempId, isSender: true, pubkey: identity.pk, 
      timestamp: Math.floor(Date.now() / 1000), local_timestamp: Date.now(), replyTo: replyId 
    }
    
    if (isDmView && activeDm) {
      newMsg.data = msgPayload;
      newMsg.isGroup = false; // ✅ Explicitly tag as DM
      setDms(prev => ({ ...prev, [activeDm]: [...(prev[activeDm] || []), newMsg].sort(sortMessages) }))
    } else if (activeGroup) {
        newMsg.rawContent = JSON.stringify(msgPayload);
        newMsg.isGroup = true;
        
        // Optimistically add to UI so it appears instantly
        useChatStore.getState().setGroupMessages(prev => {
          const msgs = prev[activeGroup.id] || [];
          return { ...prev, [activeGroup.id]: [...msgs, newMsg] };
        });

        const result = await sendGroupMessage(activeGroup.id, msgPayload, tempId, replyId);
        if (!result.success) {
          if (result.error === 'NO_KEY') {
            setToast({ type: 'error', message: 'Securing group... please try again in a moment.' });
          } else {
            setToast({ type: 'error', message: 'Failed to send to group' });
          }
          // Keep the optimistic message on screen even if the relay rejects it
        }
      }

    await saveMessage(chatId, newMsg)

    setReplyText(''); setReplyingTo(null); setShowEmojiPicker(false);
    if (activeDm) localStorage.removeItem(`draft-dm-${activeDm}`);
    if (activeGroup) localStorage.removeItem(`draft-group-${activeGroup.id}`);

    try {
      const pool = await getAuthenticatedPool(identity)
      const { finalizeEvent } = await import('nostr-tools')
      const { nip44 } = await import('nostr-tools')

if (activeDm) {
        const result = await sendDM(activeDm, msgPayload, tempId, replyId);
        if (!result.success) {
          setToast({ type: 'error', message: 'Failed to send: ' + (result.error || 'unknown') });
        }
      }
    } catch (err) { 
      console.error("Full Encryption/Send Error:", err);
      setToast({ type: 'error', message: "Failed to send: " + err.message }) 
    }
  }

  const highlightMessage = (msgId) => {
    sessionStorage.setItem('highlight-msg', msgId);
    setTimeout(() => sessionStorage.removeItem('highlight-msg'), 3000);
  };

  const handleBulkForward = () => {
    const selectedIds = useChatStore.getState().selectedMsgs;
    if (selectedIds.length === 0) return;
    setToast({ type: 'info', message: 'Select a chat to forward ' + selectedIds.length + ' messages' });
    // For now, use the standard forward modal with first message
    const firstId = selectedIds[0];
    const msgs = activeDm ? (dms[activeDm] || []) : (groupMessages[activeGroup?.id] || []);
    const msg = msgs.find(m => m.id === firstId);
    if (msg) {
      setForwardingMsg({ data: msg.data || { type: 'text', message: msg.rawContent }, originalSenderName: 'You', id: msg.id });
    }
    useChatStore.getState().clearSelection();
  };

  const handleBulkDelete = () => {
    const selectedIds = useChatStore.getState().selectedMsgs;
    if (selectedIds.length === 0) return;
    useChatStore.getState().openDialog({
      title: 'Delete Messages',
      message: `Delete ${selectedIds.length} message${selectedIds.length !== 1 ? 's' : ''}? This cannot be undone.`,
      type: 'danger',
      confirmText: 'Delete',
      onConfirm: async () => {
        const chatId = activeDm || activeGroup?.id;
        if (!chatId) return;
        const { db } = await import('./db');
        for (const id of selectedIds) {
          await db.messages.delete(id);
        }
        useChatStore.getState().setDeletedMsgs(new Set([...useChatStore.getState().deletedMsgs, ...selectedIds]));
        useChatStore.getState().clearSelection();
        setToast({ type: 'success', message: 'Messages deleted' });
      }
    });
  };

  const handleGlobalSearch = async (query) => {
      if (!query.trim()) return;
      const results = [];
      const state = useChatStore.getState();
      
      // Search across DMs
      Object.entries(state.dms).forEach(([pubkey, msgs]) => {
        msgs.forEach(msg => {
          const text = msg.data?.message || '';
          if (text.toLowerCase().includes(query.toLowerCase())) {
            results.push({
              type: 'dm',
              pubkey,
              msg,
              name: state.profiles[pubkey]?.displayName || pubkey.slice(0, 8),
              text
            });
          }
        });
      });

      // Search across groups
      Object.entries(state.groupMessages).forEach(([groupId, msgs]) => {
        msgs.forEach(msg => {
          try {
            const parsed = JSON.parse(msg.rawContent || '{}');
            if ((parsed.message || '').toLowerCase().includes(query.toLowerCase())) {
              const group = state.groups.find(g => g.id === groupId);
              results.push({
                type: 'group',
                groupId,
                msg,
                name: group?.name || groupId.slice(0, 8),
                text: parsed.message
              });
            }
          } catch (e) {}
        });
      });

      setToast({ type: 'info', message: `Found ${results.length} results for "${query}"` });
      // For now, show in search view (we'll wire up later)
      setSearchResults(results);
      setView('search');
    };

    const handleSearch = async () => {
    if (!searchQuery.trim()) return
    setIsSearching(true)
    setSearchResults([])

    let rawQuery = searchQuery.trim()

    // --- LAYER 0: UNIQUE USERNAME LOOKUP (kind: 10003) ---
    if (rawQuery.startsWith('@')) {
      const usernameToFind = rawQuery.slice(1).toLowerCase();
      if (usernameToFind.length < 3) {
        setToast({ type: 'error', message: 'Username must be at least 3 characters' });
        setIsSearching(false);
        return;
      }
      
      try {
        const pool = await getAuthenticatedPool(identity);
        const allSearchRelays = ['wss://relay.primal.net', 'wss://groups.aegispayhq.com'];
        
        // Query using #t filter (hashtag, universally supported)
        // Fetch all recent 10003 events and filter locally (bulletproof)
        const events = await queryWithTimeout(pool, allSearchRelays, { 
          kinds: [10003],
          limit: 500
        }, 5000);
        
        console.log('[Username Search] Fetched', events.length, 'total kind 10003 events');
        
        const matches = events.filter(ev => {
          const usernameTag = ev.tags.find(t => t[0] === 'username')?.[1];
          const tTag = ev.tags.find(t => t[0] === 't' && t[1] === 'cipher_username_' + usernameToFind);
          return usernameTag === usernameToFind || tTag;
        });
        
        if (matches.length > 0) {
          const match = matches[0];
          setSearchResults([{ 
            type: 'user', 
            pubkey: match.pubkey, 
            name: '@' + usernameToFind, 
            picture: null
          }]);
        } else {
          setSearchResults([]);
          setToast({ type: 'error', message: '@' + usernameToFind + ' not found. Ask them to re-save their profile.' });
        }
      } catch (err) {
        console.error("Username search failed:", err);
        setToast({ type: 'error', message: 'Search failed' });
      } finally {
        setIsSearching(false);
      }
      return;
    }

    // --- LAYER A: URL EXTRACTION (pasted invite links) ---
    try {
      if (rawQuery.startsWith('http')) {
        const url = new URL(rawQuery)
        const gp = url.searchParams.get('group')
        const np = url.searchParams.get('naddr')
        if (gp) {
          rawQuery = gp
          console.log('[search] extracted group ID from URL:', rawQuery)
        } else if (np) {
          const { nip19 } = await import('nostr-tools')
          const d = nip19.decode(np)
          if (d.type === 'naddr') {
            rawQuery = d.data.identifier
            console.log('[search] extracted group ID from naddr:', rawQuery)
          }
        }
      }
    } catch (e) { console.warn('[search] URL parse failed', e) }

    rawQuery = rawQuery.replace(/^@/, '')
    if (/^[0-9a-f]{64,}$/i.test(rawQuery)) {
      rawQuery = rawQuery.slice(0, 64)
    }

    console.log("Searching for:", rawQuery)

    // --- LAYER B: INSTANT 16-CHAR GROUP ID (before ANY await) ---
    if (rawQuery.length >= 12 && rawQuery.length <= 20 && /^[a-z0-9_-]+$/i.test(rawQuery) && !rawQuery.includes(' ')) {
      console.log('[search] instant group ID match:', rawQuery)
      setSearchResults([{
        type: 'group',
        id: rawQuery,
        name: 'Group ' + rawQuery,
        isChannel: false,
        creator: ''
      }])
      setIsSearching(false)
      return
    }

    const isNpub = rawQuery.startsWith('npub1');
    const isHex = /^[0-9a-f]{64}$/i.test(rawQuery);
    const isPartialHex = /^[0-9a-f]{10,63}$/i.test(rawQuery);
    const isNip05 = rawQuery.includes('@');

    if (isPartialHex) {
      setToast({ type: 'error', message: "Hex public keys must be exactly 64 characters. Yours is " + rawQuery.length + " characters." });
      setIsSearching(false);
      return;
    }
    
    try {
      const { SimplePool, nip19 } = await import('nostr-tools')
      const pool = new SimplePool({ enablePing: true, enableReconnect: true })

      // --- LAYER 1: INSTANT LOCAL CACHE ---
      const localMatches = await db.profiles.filter(p => 
        (p.name && p.name.toLowerCase().includes(rawQuery.toLowerCase())) || 
        (p.displayName && p.displayName.toLowerCase().includes(rawQuery.toLowerCase()))
      ).toArray();

      if (localMatches.length > 0) {
        setSearchResults(localMatches.map(p => ({ type: 'user', pubkey: p.pubkey, name: p.displayName, picture: p.picture })));
        setIsSearching(false);
        return;
      }

      // --- LAYER 2: NIP-05 LOOKUP ---
      if (isNip05 && !isNpub) {
        const [name, domain] = rawQuery.split('@');
        try {
          const res = await fetch(`https://${domain}/.well-known/nostr.json?name=${name}`);
          const data = await res.json();
          const targetPubkey = data.names?.[name];
          if (targetPubkey) {
            setSearchResults([{ type: 'user', pubkey: targetPubkey, name: name, picture: null }]);
            setIsSearching(false);
            return;
          }
        } catch (e) { console.warn("NIP-05 lookup failed, continuing..."); }
      }

      // --- LAYER 3: DIRECT NPUB/HEX LOOKUP ---
      if (isNpub || isHex) {
        let targetPubkey = rawQuery;
        
        if (isNpub) {
          const decoded = nip19.decode(rawQuery);
          targetPubkey = decoded.data;
          // FIX: nostr-tools sometimes returns a Uint8Array instead of a hex string
          if (typeof targetPubkey !== 'string') {
            targetPubkey = Array.from(targetPubkey).map(b => b.toString(16).padStart(2, '0')).join('');
          }
        }

        // Set the result IMMEDIATELY so the UI updates instantly, even if the relay is slow
        setSearchResults([{ type: 'user', pubkey: targetPubkey, name: targetPubkey.slice(0,8), picture: null }]);
        
        // Then try to fetch their actual profile to get their name/picture
        const profileEvents = await queryWithTimeout(
          pool, 
          ['wss://purplepag.es', 'wss://relay.primal.net'], 
          { kinds: [0], authors: [targetPubkey] }, 
          4000
        );

        if (profileEvents.length > 0) {
          try {
            const p = JSON.parse(profileEvents[0].content);
            setSearchResults([{ 
              type: 'user', 
              pubkey: targetPubkey, 
              name: p.display_name || p.name || targetPubkey.slice(0,8), 
              picture: p.picture 
            }]);
          } catch (e) {}
        }
        
        setIsSearching(false);
        return;
      }

      // --- LAYER 4: VERTEX DVM PROFILE SEARCH (NEW) ---
      try {
        const { finalizeEvent } = await import('nostr-tools');
        const dvmPool = new SimplePool();
        // 1. Create a request event (kind 5315)
        const requestEvent = finalizeEvent({
          kind: 5315,
          created_at: Math.floor(Date.now() / 1000),
          tags: [['param', 'search', rawQuery], ['param', 'limit', '10']],
          content: ''
        }, identity.sk);

        // 2. Publish to Vertex
        await Promise.allSettled(dvmPool.publish(['wss://relay.vertexlab.io'], requestEvent));

        // 3. Fetch the response (kind 6315)
        const responseEvents = await Promise.race([
          dvmPool.querySync(['wss://relay.vertexlab.io'], { kinds: [6315], '#e': [requestEvent.id] }),
          new Promise(resolve => setTimeout(() => resolve([]), 4000)) // 4s timeout
        ]);

        if (responseEvents.length > 0) {
          const responseEvent = responseEvents[0];
          const pubkeys = JSON.parse(responseEvent.content).map(p => p.pubkey);
          
          if (pubkeys.length > 0) {
            // Fetch the actual profiles for these pubkeys
            const profileEvents = await pool.querySync(['wss://relay.primal.net'], { kinds: [0], authors: pubkeys });
            const profiles = profileEvents.map(ev => {
              const data = JSON.parse(ev.content);
              return { type: 'user', pubkey: ev.pubkey, name: data.display_name || data.name || ev.pubkey.slice(0, 8), picture: data.picture };
            });
            setSearchResults(profiles);
            setIsSearching(false);
            return;
          }
        }
      } catch (dvmError) {
        console.warn("Vertex DVM search failed, falling back to NIP-50...", dvmError);
      }

      // --- LAYER 5: STANDARD NIP-50 FALLBACK ---
      const publicSearchRelays = ['wss://relay.vertexlab.io', 'wss://relay.noswhere.com', 'wss://relay.primal.net'];
      const events = await Promise.race([
        Promise.all([
          pool.querySync(publicSearchRelays, { kinds: [0, 41], search: rawQuery, limit: 30 }),
          pool.querySync(['wss://groups.aegispayhq.com'], { kinds: [9002], limit: 200 })
        ]).then(res => [...res[0], ...res[1]]),
        new Promise(resolve => setTimeout(() => resolve([]), 4000))
      ]);

      let matchedProfiles = [];
      let matchedGroups = [];

      events.forEach(ev => {
        if (ev.kind === 0) {
          try {
            const d = JSON.parse(ev.content);
            matchedProfiles.push({ type: 'user', pubkey: ev.pubkey, name: d.display_name || d.name || ev.pubkey.slice(0,8), picture: d.picture });
          } catch(e) {}
        } else if (ev.kind === 41) {
          try {
            const d = JSON.parse(ev.content);
            matchedGroups.push({ type: 'group', id: ev.tags.find(t=>t[0]==='d')?.[1], name: d.name, isChannel: d.isChannel, creator: ev.pubkey });
          } catch(e) {}
        } else if (ev.kind === 39000 || ev.kind === 9002) {
          const getTag = (t) => ev.tags.find(x => x[0] === t)?.[1];
          const groupId = getTag('h') || getTag('d');
          const groupName = getTag('name');
          if (groupId && groupName && groupName.toLowerCase().includes(rawQuery.toLowerCase())) {
            matchedGroups.push({ type: 'group', id: groupId, name: groupName, isChannel: false, creator: ev.pubkey });
          }
        }
      });

      // Fallback: If the user pastes a 16-character Group ID, let them join it directly
      if (rawQuery.length >= 12 && rawQuery.length <= 20 && !rawQuery.includes(' ')) {
        if (!matchedGroups.find(g => g.id === rawQuery)) {
          matchedGroups.push({ type: 'group', id: rawQuery, name: "Group " + rawQuery, isChannel: false, creator: "" });
        }
      }

      const uniqueUsers = Array.from(new Map(matchedProfiles.map(p => [p.pubkey, p])).values());
      const uniqueGroups = Array.from(new Map(matchedGroups.map(g => [g.id, g])).values());
      
      setSearchResults([...uniqueUsers.slice(0, 10), ...uniqueGroups.slice(0, 10)]);

    } catch (err) { 
      console.error("Search failed entirely:", err); 
    } finally { 
      setIsSearching(false); 
    }
  }

  const requestToJoinGroup = async (groupId, groupName, groupCreator) => {
    if (!groupCreator) {
      // No creator known — fall back to auto-join (legacy groups)
      return joinGroupById(groupId, groupName);
    }
    
    // Send DM to creator asking for approval
    const payload = {
      type: 'join_request',
      groupId,
      groupName,
      requester: identity.pk,
      requesterName: profiles[identity.pk]?.displayName || identity.pk.slice(0, 8)
    };
    
    await sendDM(groupCreator, payload);
    setToast({ type: 'success', message: "Join request sent to admin. You will be notified when approved." });
    
    // Also add them locally to a "pending" list so they can see the group with a waiting message
    useChatStore.getState().addJoinRequest(groupId, identity.pk);
  };

  const joinGroupById = async (groupId, passedName = null) => {
    if (!groupId) return;
    setIsSearching(true);
    let realName = passedName || 'Unnamed Group';

    try {
      const localGroups = getMyGroups(identity.pk);
      const localMatch = localGroups.find(g => g.id === groupId);

      if (!passedName && localMatch && localMatch.name && localMatch.name !== 'Unnamed Group') {
        realName = localMatch.name;
      } else if (!passedName) {
        try {
          const pool = await getAuthenticatedPool(identity);
          const events = await queryWithTimeout(pool, groupRelays, { kinds: [9002], limit: 200 }, 3000);
          const match = events.find(ev => ev.tags.find(t => t[0] === 'h')?.[1] === groupId);
          if (match) {
            const nameTag = match.tags.find(t => t[0] === 'name')?.[1];
            if (nameTag) realName = nameTag;
          }
        } catch (e) {}
      }

      if (realName === 'Unnamed Group') {
        const userInput = window.prompt("What is this group called?", "");
        if (userInput && userInput.trim()) realName = userInput.trim();
      }

      const newGroupObj = { id: groupId, name: realName, isChannel: false, creator: '' };
        const existingGroups = getMyGroups(identity.pk);
        if (!existingGroups.find(g => g.id === newGroupObj.id)) {
          setMyGroups(identity.pk, [...existingGroups, newGroupObj]);
        }
      
      const idx = localGroups.findIndex(g => g.id === groupId);
      if (idx === -1) localGroups.push(newGroupObj);
      else localGroups[idx].name = realName;
      setMyGroups(identity.pk, localGroups);
      
      setGroups(prev => [newGroupObj, ...(prev || []).filter(g => g.id !== groupId)]);
      openChat('group', groupId, newGroupObj);
      setToast({ type: 'success', message: 'Joined group' });
    } catch (err) {
      console.error('[joinGroupById] error:', err);
    } finally {
      setIsSearching(false);
      if (window.location.search.length > 0) window.history.replaceState({}, document.title, window.location.pathname);
    }
  };

  // FIX: Clear old account data when switching accounts to prevent DM leaks
  useEffect(() => {
    // Wait until the identity is fully loaded before checking
    if (!identity?.pk) return; 
    
    const lastUser = localStorage.getItem('cipher_last_user');
    if (lastUser && lastUser !== identity.pk) {
      useChatStore.setState({ dms: {}, groups: [], groupMessages: {}, profiles: {}, unreadCounts: {}, reactions: {} });
      console.warn("Switching accounts! Wiping old local data...");
      db.messages.clear().catch(console.error);
      db.chatReads.clear().catch(console.error);
      localStorage.removeItem('cipher_my_groups');
    }
    localStorage.setItem('cipher_last_user', identity.pk);
  }, [identity?.pk]);

  useEffect(() => {
    const urlParams = new URLSearchParams(window.location.search);
    const joinId = urlParams.get('group') || urlParams.get('join') || urlParams.get('g');
    const joinName = urlParams.get('name');
    if (joinId && identity?.pk) { 
      console.log("[URL] Found group invite link for:", joinId);
      // Try to fetch group creator to determine if approval is needed
      (async () => {
        try {
          const pool = await getAuthenticatedPool(identity);
          const events = await queryWithTimeout(pool, groupRelays, { kinds: [9002], limit: 200 }, 3000);
          const match = events.find(ev => ev.tags.find(t => t[0] === 'h')?.[1] === joinId);
          const creator = match?.pubkey;
          
          if (creator && creator !== identity.pk) {
            // Group exists and I'm not the creator — request approval
            await requestToJoinGroup(joinId, joinName, creator);
          } else {
            // Creator or unknown — auto-join
            joinGroupById(joinId, joinName);
          }
        } catch (e) {
          joinGroupById(joinId, joinName);
        }
      })();
    }
  }, [identity?.pk]);

  const handleNaddr = async (naddr) => {
    try {
      const { nip19 } = await import('nostr-tools');
      const decoded = nip19.decode(naddr);
      if (decoded.type === 'naddr' && decoded.data.kind === 39000) {
        const groupId = decoded.data.identifier;
        const relayUrl = decoded.data.relays?.[0] || 'wss://groups.aegispayhq.com';
        console.log("[handleNaddr] Decoded group:", groupId, "on relay:", relayUrl);
        await joinGroupById(groupId);
      }
    } catch (e) {
      console.error("[handleNaddr] Failed to decode naddr:", e);
    }
  };

  const leaveGroup = async (groupId) => {
    useChatStore.getState().openDialog({ title: 'Leave Group', message: 'Are you sure you want to leave this group?', type: 'danger', confirmText: 'Leave', onConfirm: async () => {
    
    try {
      const { finalizeEvent } = await import('nostr-tools');
      const pool = await getAuthenticatedPool(identity);
      // NIP-29 Leave Group (kind 9022)
      const leaveEv = finalizeEvent({
        kind: 9022, created_at: Math.floor(Date.now() / 1000),
        tags: [["h", groupId]], content: ""
      }, identity.sk);
      await Promise.allSettled(pool.publish(groupRelays, leaveEv));
    } catch (e) {
      console.error("Failed to send leave event to relay:", e);
    }

    // Remove from localStorage
    const localGroups = getMyGroups(identity.pk);
    const updated = localGroups.filter(g => g.id !== groupId);
    setMyGroups(identity.pk, updated);
    
    // Update state and go back to list
    if (typeof setGroups === 'function') setGroups(updated);
    setView('list');
    if (typeof fetchChats === 'function') fetchChats();
  } });
  };

  
  // Trigger fetch when Group Info opens
  
  const fetchGroups = async () => {
    try {
      const pool = await getAuthenticatedPool(identity);
      const events = await queryWithTimeout(pool, groupRelays, { kinds: [39000, 9002], limit: 200 });
      
      const parsed = events.map(ev => {
        const tag = (n) => ev.tags.find((t) => t[0] === n)?.[1];
        const id = tag('d') || tag('h') || ev.id;
        return { id, name: tag('name') || id, about: tag('about') || '', kind: 'group', raw: ev };
      });

      const uniqueGroups = Array.from(new Map(parsed.map(g => [g.id, g])).values());
      
      const localGroups = getMyGroups(identity.pk);
      const allGroups = [...uniqueGroups];
      localGroups.forEach(lg => {
        if (!allGroups.find(g => g.id === lg.id)) allGroups.push(lg);
      });
      
      setGroups(allGroups);
      return allGroups;
    } catch (e) { 
      console.error("[fetchGroups] NDK failed:", e); 
      return []; 
    }
  };

  const createGroup = async (e) => {
    if (e) e.preventDefault();
    if (!newGroupName.trim()) return;
    
    // Capture the values BEFORE we clear the form
    const gName = newGroupName;
    const gAbout = newGroupAbout;
    const gChannel = isChannel;
    
    setShowCreateGroup(false);
    setShowMenu(false);
    setNewGroupName(""); 
    setNewGroupAbout(""); 
    setIsChannel(false);

    try {
      const { finalizeEvent } = await import("nostr-tools");
      const pool = await getAuthenticatedPool(identity);
      const groupId = (globalThis.crypto?.randomUUID?.() || Date.now().toString()).replace(/-/g, "").slice(0, 16);
      
      console.log("[createGroup] groupId:", groupId);

      const createEv = finalizeEvent({
        kind: 9007, created_at: Math.floor(Date.now() / 1000),
        tags: [["h", groupId], ["name", gName], ["about", gAbout || ""], ["open"], ["p", identity.pk, "admin"]], // <-- Added ["public"]
        content: "",
      }, identity.sk);
      
      const r9007 = await Promise.allSettled(pool.publish(groupRelays, createEv));
      let ok = 0;
      r9007.forEach((r) => { if (r.status === "fulfilled") ok++; });
      if (!ok) throw new Error("No relay accepted 9007");

      const metaEv = finalizeEvent({
        kind: 9002, created_at: Math.floor(Date.now() / 1000),
        tags: [["h", groupId], ["name", gName], ["about", gAbout || ""]],
        content: "",
      }, identity.sk);
      await Promise.allSettled(pool.publish(groupRelays, metaEv));

      // Auto-join the group as the creator (kind 9021)
      const joinEv = finalizeEvent({
        kind: 9021, created_at: Math.floor(Date.now() / 1000),
        tags: [["h", groupId]], content: "Creator"
      }, identity.sk);
      await Promise.allSettled(pool.publish(groupRelays, joinEv));

      try {
        const existing = await getCurrentGroupKey(groupId);
        if (!existing) {
          const key = generateGroupKey();
          await putGroupKey(groupId, 1, key);
          await distributeGroupKey({
            senderPrivkey: identity.sk, senderPubkey: identity.pk,
            groupId, epoch: 1, keyBytes: key, recipients: [identity.pk],
            publish: async (dmEv) => {
              const results = await Promise.allSettled(pool.publish(groupRelays, dmEv));
              if (!results.some(r => r.status === 'fulfilled')) throw new Error('dm rejected');
            },
          });
        }
      } catch (e) { console.warn('[createGroup] key bootstrap deferred', e); }

      const newGroupObj = {
        id: groupId, name: gName, about: gAbout || "",
        isChannel: gChannel, creator: identity.pk, members: [identity.pk]
      };

      const localGroups = getMyGroups(identity.pk);
      if (!localGroups.find(g => g.id === groupId)) {
        localGroups.push(newGroupObj);
        setMyGroups(identity.pk, localGroups);
      }
      setGroups((prev) => [newGroupObj, ...(prev || []).filter(c => c.id !== groupId)]);
      setToast({ type: 'success', message: 'Group created!' });
    } catch (err) { 
      console.error("[createGroup] FAILED:", err); 
      setToast({ type: 'error', message: 'Failed to create group' });
    }
  };

  const ToastUI = () => toast && (
    <div className="fixed top-6 left-1/2 -translate-x-1/2 z-[200] bg-surfaceLight border border-white/10 px-5 py-3 rounded-2xl shadow-2xl animate-slide-up flex items-center gap-3">
      <div className={`w-2 h-2 rounded-full ${toast.type === 'error' ? 'bg-red-500' : 'bg-green-500'}`} />
      <span className="text-sm font-semibold text-white">{toast.message}</span>
    </div>
  )

  const Emojis = ['😀','😂','🥰','😎','😭','🤔','👍','🔥','❤️','🚀','💯','🙏','✨','💀','🤯','🤫','💩','🤝','👀','💸']

  const deleteMessage = async (msgId) => {
    useChatStore.getState().openDialog({ title: 'Delete Message', message: 'Are you sure you want to delete this?', type: 'danger', confirmText: 'Delete', onConfirm: async () => {
    try {
      const { finalizeEvent } = await import('nostr-tools');
      const pool = await getAuthenticatedPool(identity);
      const ev = finalizeEvent({
        kind: 5, created_at: Math.floor(Date.now() / 1000),
        tags: [['e', msgId]], content: 'Deleted'
      }, identity.sk);
      await Promise.allSettled(pool.publish(generalRelays, ev));
      setDeletedMsgs(prev => new Set(prev).add(msgId));
      setToast({ type: 'success', message: 'Message deleted' });
    } catch (e) { 
      console.error(e); 
      setToast({ type: 'error', message: 'Failed to delete' });
    } } });
  };

;

  const markAsRead = async (chatId) => {
    try {
      await db.chatReads.put({ chatId, lastRead: Math.floor(Date.now() / 1000) });
      setUnreadCounts(prev => ({ ...prev, [chatId]: 0 }));
    } catch(e) {}
  }

  const openChat = (type, id, groupObj = null) => {
    markAsRead(id);
    setTypingUsers({});
    setGroupTypingUsers({});
    if (type === 'dm') { 
      setActiveDm(id); 
      setActiveGroup(null); // ✅ Clear group state
      setView('dm'); 
    }
    else { 
      setActiveGroup(groupObj); 
      setActiveDm(null); // ✅ Clear DM state
      setView('group'); 
    }
  }

  if (loading) {
    return (
      <div className="p-4 h-full animate-fade-in">
        <div className="flex justify-between items-center mb-6 px-2">
          <div className="h-8 w-24 bg-surfaceLight rounded-lg animate-pulse" />
          <div className="flex gap-2">
            <div className="h-8 w-8 bg-surfaceLight rounded-full animate-pulse" />
            <div className="h-8 w-8 bg-surfaceLight rounded-full animate-pulse" />
          </div>
        </div>
        
        <div className="space-y-3">
          {[1, 2, 3, 4, 5, 6].map((i) => (
            <div key={i} className="bg-surface p-4 rounded-2xl border border-white/5 flex items-center gap-4">
              {/* Avatar Skeleton */}
              <div className="w-12 h-12 rounded-full bg-surfaceLight animate-pulse shrink-0" />
              {/* Text Skeletons */}
              <div className="flex-1 space-y-2">
                <div className="h-4 bg-surfaceLight rounded animate-pulse w-1/3" />
                <div className="h-3 bg-surfaceLight rounded animate-pulse w-1/2" />
              </div>
            </div>
          ))}
        </div>
      </div>
    )
  }

  // --- CHAT LIST VIEW ---
  if (view === 'list') {
    return (
      <motion.div initial={{ x: -20, opacity: 0 }} animate={{ x: 0, opacity: 1 }} exit={{ x: -20, opacity: 0 }} transition={{ duration: 0.2 }} className="flex-1 overflow-y-auto min-h-0 p-4 pb-24 relative">
        <ToastUI />
        <div className="flex justify-between items-center mb-6">
          <div className="flex items-center gap-2"><img src="/logo_raw.png" alt="Cipher" className="h-8 w-8 object-contain" /><span className="text-xl font-bold tracking-tight text-white">Cipher</span></div>
          <div className="flex gap-2">
            
          <button onClick={() => setShowBookmarks(true)} className="p-2 text-white/50 hover:text-white" title="Saved">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/></svg>
            </button>
            <button onClick={() => setShowNotifCenter(true)} className="p-2 text-white/50 hover:text-white" title="Activity">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
            </button>
            <button onClick={fetchChats} className="p-2 text-white/50 hover:text-white"><RefreshCw size={20}/></button>
            <button onClick={() => setView('search')} className="p-2 text-white/50 hover:text-white"><Search size={20}/></button>
          <button onClick={() => setShowQRScanner(true)} className="p-2 text-white/50 hover:text-white">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M3 7V5a2 2 0 0 1 2-2h2"/><path d="M17 3h2a2 2 0 0 1 2 2v2"/><path d="M21 17v2a2 2 0 0 1-2 2h-2"/><path d="M7 21H5a2 2 0 0 1-2-2v-2"/><line x1="7" y1="12" x2="17" y2="12"/></svg>
          </button>
          </div>
        </div>

        <ChatList onOpenChat={openChat} onGlobalSearch={handleGlobalSearch} />

              <CreateGroupModal createGroup={createGroup} />

        <FloatingMenu /><MyProfileModal identity={identity} />
        <BookmarksViewer 
          isOpen={showBookmarks} 
          onClose={() => setShowBookmarks(false)} 
          onJump={(chatId, msgId, isGroup) => {
            if (isGroup) {
              const g = groups.find(x => x.id === chatId);
              if (g) openChat('group', chatId, g);
            } else {
              openChat('dm', chatId);
            }
            setTimeout(() => {
              const el = document.getElementById(`msg-${msgId}`);
              if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 500);
          }} 
        />
        <NotificationCenter 
          isOpen={showNotifCenter} 
          onClose={() => setShowNotifCenter(false)} 
          onJump={(type, id) => {
            if (type === 'group') {
              const g = groups.find(x => x.id === id);
              if (g) openChat('group', id, g);
            } else {
              openChat('dm', id);
            }
          }} 
        />
        <QRScanner 
          isOpen={showQRScanner} 
          onClose={() => setShowQRScanner(false)} 
          onScanned={(result) => {
            if (result.type === 'user') {
              openChat('dm', result.pubkey);
            } else if (result.type === 'group') {
              joinGroupById(result.groupId);
            }
          }} 
        />
        <BroadcastModal 
          isOpen={!!broadcastProduct} 
          onClose={() => setBroadcastProduct(null)} 
          product={broadcastProduct} 
          onBroadcast={handleBroadcastSubmit} 
        />
        <ProductEditModal 
          editingProduct={editingProduct} 
          onClose={() => setEditingProduct(null)} 
          onSubmit={handleSaveEditedProduct} 
          identity={identity} 
        />
        <VendorStorefront 
          isOpen={!!vendorStorefrontPubkey} 
          onClose={() => setVendorStorefrontPubkey(null)} 
          vendorPubkey={vendorStorefrontPubkey} 
          profiles={profiles} 
          identity={identity} 
          onOpenChat={(pk) => openChat('dm', pk)} 
          onBuy={(p, vp) => openChat('dm', vp)} 
        />


      </motion.div>
    )
  }

  // --- SHOP VIEW ---

  const handleConfirmOrder = (order) => {
          setCheckoutProduct(null);
          const targetDm = order.vendorPubkey || identity.pk;
          
          if (typeof openChat === 'function') {
            openChat('dm', targetDm);
          } else {
            setActiveDm(targetDm);
            setActiveGroup(null);
            setView('dm');
          }
          
          setTimeout(async () => {
            try {
              const { finalizeEvent, nip44 } = await import('nostr-tools');
              const pool = await getAuthenticatedPool(identity);
              
              const payload = { 
                type: 'cipher_order', 
                productName: order.productName, 
                amountFiat: order.amountFiat,
                amountCrypto: order.amountCrypto,
                currency: order.currency,
                status: 'payment_sent',
                shippingAddress: order.shippingAddress || 'No address provided'
              };
              
              const shared = nip44.v2.utils.getConversationKey(identity.sk, targetDm);
              const enc = nip44.v2.encrypt(JSON.stringify(payload), shared);
              const ev = finalizeEvent({ kind: 4, created_at: Math.floor(Date.now() / 1000), tags: [['p', targetDm]], content: enc }, identity.sk);
              
              await saveMessage(targetDm, { id: ev.id, isSender: true, timestamp: ev.created_at, data: payload, pubkey: identity.pk, isGroup: false });
              Promise.allSettled(pool.publish(generalRelays, ev)).catch(console.error);
              setToast({ type: 'success', message: 'Order sent!' });
            } catch (err) { 
              console.error("[Checkout] Background task failed:", err); 
            }
          }, 50);
        };

  // --- SEARCH VIEW ---

  if (view === 'search' && searchResults.length > 0 && searchResults[0]?.msg) {
    return <MessageSearchResults identity={identity} setView={setView} openChat={openChat} />;
  }

  if (view === 'search') {
    return (
      <SearchView
        ToastUI={ToastUI}
        handleSearch={handleSearch}
        joinGroupById={joinGroupById}
        openChat={openChat}
      />
    )
  }

  // --- ACTIVE DM VIEW ---
  if (view === 'dm' && activeDm) {
    return (
      <>
        <DmView identity={identity} isScammer={isScammer} dms={dms} activeDm={activeDm} profiles={profiles} deletedMsgs={deletedMsgs} reactions={reactions} selectedMessage={selectedMessage} forwardingMsg={forwardingMsg} showFullEmoji={showFullEmoji} reviewTarget={reviewTarget} scrollRef={scrollRef} sendReaction={sendReaction} handleMessageAction={handleMessageAction} setSelectedMessage={setSelectedMessage} setShowFullEmoji={setShowFullEmoji} setForwardingMsg={setForwardingMsg} setReviewTarget={setReviewTarget} handleForwardSubmit={handleForwardSubmit} sendMessage={sendMessage} setNewMessage={setNewMessage} newMessage={newMessage} canPost={canPost} handleImageUpload={handleImageUpload} startRecording={startRecording} stopRecording={stopRecording} isRecording={isRecording} uploadingImage={uploadingImage} setProfilePubkey={setProfilePubkey} profilePubkey={profilePubkey} sendReview={sendReview} setToast={setToast} openChat={openChat} onViewStorefront={setVendorStorefrontPubkey} />

        <BookmarksViewer 
          isOpen={showBookmarks} 
          onClose={() => setShowBookmarks(false)} 
          onJump={(chatId, msgId, isGroup) => {
            if (isGroup) {
              const g = groups.find(x => x.id === chatId);
              if (g) openChat('group', chatId, g);
            } else {
              openChat('dm', chatId);
            }
            setTimeout(() => {
              const el = document.getElementById(`msg-${msgId}`);
              if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 500);
          }} 
        />
        <NotificationCenter 
          isOpen={showNotifCenter} 
          onClose={() => setShowNotifCenter(false)} 
          onJump={(type, id) => {
            if (type === 'group') {
              const g = groups.find(x => x.id === id);
              if (g) openChat('group', id, g);
            } else {
              openChat('dm', id);
            }
          }} 
        />
        <QRScanner 
          isOpen={showQRScanner} 
          onClose={() => setShowQRScanner(false)} 
          onScanned={(result) => {
            if (result.type === 'user') {
              openChat('dm', result.pubkey);
            } else if (result.type === 'group') {
              joinGroupById(result.groupId);
            }
          }} 
        />
        <BroadcastModal 
          isOpen={!!broadcastProduct} 
          onClose={() => setBroadcastProduct(null)} 
          product={broadcastProduct} 
          onBroadcast={handleBroadcastSubmit} 
        />
        <ProductEditModal 
          editingProduct={editingProduct} 
          onClose={() => setEditingProduct(null)} 
          onSubmit={handleSaveEditedProduct} 
          identity={identity} 
        />
        <VendorStorefront 
          isOpen={!!vendorStorefrontPubkey} 
          onClose={() => setVendorStorefrontPubkey(null)} 
          vendorPubkey={vendorStorefrontPubkey} 
          profiles={profiles} 
          identity={identity} 
          onOpenChat={(pk) => openChat('dm', pk)} 
          onBuy={(p, vp) => openChat('dm', vp)} 
        />
      </>
    );
  }

  // --- ACTIVE GROUP VIEW ---
  if (view === 'group' && activeGroup) {
    return (
      <>
        <GroupView 
      identity={identity} isScammer={isScammer} activeGroup={activeGroup} groupMessages={groupMessages} profiles={profiles} 
      deletedMsgs={deletedMsgs} reactions={reactions} selectedMessage={selectedMessage} forwardingMsg={forwardingMsg} 
      showFullEmoji={showFullEmoji} reviewTarget={reviewTarget} scrollRef={scrollRef} sendReaction={sendReaction} 
      handleMessageAction={handleMessageAction} setSelectedMessage={setSelectedMessage} setShowFullEmoji={setShowFullEmoji} 
      setForwardingMsg={setForwardingMsg} setReviewTarget={setReviewTarget} handleForwardSubmit={handleForwardSubmit} 
      sendMessage={sendMessage} setNewMessage={setNewMessage} newMessage={newMessage} canPost={canPost} 
      handleImageUpload={handleImageUpload} startRecording={startRecording} stopRecording={stopRecording} 
      isRecording={isRecording} uploadingImage={uploadingImage} setProfilePubkey={setProfilePubkey} 
      profilePubkey={profilePubkey} sendReview={sendReview} setToast={setToast} openChat={openChat} 
      unpinMessage={unpinMessage} groupMembers={groupMembers} addMember={addMember} kickMember={kickMember} promoteMember={promoteMember} 
      leaveGroup={leaveGroup} showGroupInfo={showGroupInfo} setShowGroupInfo={setShowGroupInfo} updateGroupSettings={updateGroupSettings}
      openPostListing={setPostListingGroup} onViewStorefront={setVendorStorefrontPubkey}
    />

        <BookmarksViewer 
          isOpen={showBookmarks} 
          onClose={() => setShowBookmarks(false)} 
          onJump={(chatId, msgId, isGroup) => {
            if (isGroup) {
              const g = groups.find(x => x.id === chatId);
              if (g) openChat('group', chatId, g);
            } else {
              openChat('dm', chatId);
            }
            setTimeout(() => {
              const el = document.getElementById(`msg-${msgId}`);
              if (el) el.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }, 500);
          }} 
        />
        <NotificationCenter 
          isOpen={showNotifCenter} 
          onClose={() => setShowNotifCenter(false)} 
          onJump={(type, id) => {
            if (type === 'group') {
              const g = groups.find(x => x.id === id);
              if (g) openChat('group', id, g);
            } else {
              openChat('dm', id);
            }
          }} 
        />
        <QRScanner 
          isOpen={showQRScanner} 
          onClose={() => setShowQRScanner(false)} 
          onScanned={(result) => {
            if (result.type === 'user') {
              openChat('dm', result.pubkey);
            } else if (result.type === 'group') {
              joinGroupById(result.groupId);
            }
          }} 
        />
        <BroadcastModal 
          isOpen={!!broadcastProduct} 
          onClose={() => setBroadcastProduct(null)} 
          product={broadcastProduct} 
          onBroadcast={handleBroadcastSubmit} 
        />
        <ProductEditModal 
          editingProduct={editingProduct} 
          onClose={() => setEditingProduct(null)} 
          onSubmit={handleSaveEditedProduct} 
          identity={identity} 
        />
        <VendorStorefront 
          isOpen={!!vendorStorefrontPubkey} 
          onClose={() => setVendorStorefrontPubkey(null)} 
          vendorPubkey={vendorStorefrontPubkey} 
          profiles={profiles} 
          identity={identity} 
          onOpenChat={(pk) => openChat('dm', pk)} 
          onBuy={(p, vp) => openChat('dm', vp)} 
        />
      </>
    );
  }

  return null;
}

function MessageIcon({ size }) {
  return <svg width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2" strokeLinecap="round" strokeLinejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
}
